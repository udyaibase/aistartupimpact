generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AIResearcher {
  id               String   @id
  name             String
  university       String
  position         String
  photoUrl         String?
  bio              String
  researchAreas    String[]
  notablePapers    String[]
  linkedinUrl      String?
  googleScholarUrl String?
  citations        Int      @default(0)
  hIndex           Int      @default(0)
  displayOrder     Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([displayOrder])
  @@index([isActive])
  @@index([university])
}

model AdCampaign {
  id               String         @id
  clientName       String
  clientEmail      String
  companyName      String
  companyLogo      String?
  status           CampaignStatus @default(DRAFT)
  startDate        DateTime
  endDate          DateTime
  totalBudgetPaise BigInt         @default(0)
  notes            String?
  createdBy        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime
  AdCreative       AdCreative[]

  @@index([startDate, endDate])
  @@index([status])
}

model AdClick {
  id          String     @id
  creativeId  String
  articleId   String?
  sessionHash String
  countryCode String?
  createdAt   DateTime   @default(now())
  AdCreative  AdCreative @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  @@index([creativeId, createdAt])
}

model AdCreative {
  id              String         @id
  campaignId      String
  zone            AdZoneType
  headline        String
  bodyText        String
  ctaText         String
  ctaUrl          String
  imageUrl        String?
  isActive        Boolean        @default(true)
  impressionCount Int            @default(0)
  clickCount      Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  AdClick         AdClick[]
  AdCampaign      AdCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  AdImpression    AdImpression[]

  @@index([campaignId])
  @@index([zone, isActive])
}

model AdImpression {
  id          String     @id
  creativeId  String
  articleId   String?
  sessionHash String
  countryCode String?
  createdAt   DateTime   @default(now())
  AdCreative  AdCreative @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  @@index([creativeId, createdAt])
}

model AffiliateClick {
  id          String      @id @default(cuid())
  toolId      String
  sessionHash String
  ipHash      String?
  referrer    String?
  sourcePage  ClickSource @default(OTHER)
  device      String?
  browser     String?
  os          String?
  country     String?
  createdAt   DateTime    @default(now())
  AiTool      AiTool      @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([toolId, createdAt])
  @@index([createdAt])
  @@index([ipHash, toolId, createdAt])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AiTool {
  id                   String                   @id
  name                 String
  slug                 String                   @unique
  slugChangedAt        DateTime?
  previousSlugs        String[]                 @default([])
  tagline              String
  description          String
  websiteUrl           String
  affiliateUrl         String?
  twitterUrl           String?
  linkedinUrl          String?
  socialLinks          Json?
  logoUrl              String?
  screenshotUrls       String[]
  screenshotMeta       Json?
  demoVideoUrl         String?
  categoryId           String
  pricingModel         PricingModel             @default(FREEMIUM)
  freeTrialDays        Int?
  startingPrice        Int?
  hasApi               Boolean                  @default(false)
  hasMobileApp         Boolean                  @default(false)
  launchYear           Int?
  headquartersCountry  String?
  founderNames         String[]
  avgRating            Float                    @default(0)
  reviewCount          Int                      @default(0)
  status               ToolApprovalStatus       @default(PENDING)
  contentReviewed      Boolean                  @default(false)
  isFeatured           Boolean                  @default(false)
  featuredUntil        DateTime?
  submittedBy          String?
  approvedBy           String?
  approvedAt           DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime
  deletedAt            DateTime?
  aiQualityScore       Int?
  aiSpamFlag           Boolean                  @default(false)
  aiSuggestedEdits     String[]
  upvoteCount          Int                      @default(0)
  saveCount            Int                      @default(0)
  clicks               Int                      @default(0)
  isUrlVerified        Boolean                  @default(false)
  listingTier          ListingTier              @default(FREE)
  paymentStatus        PaymentStatus            @default(PENDING)
  pendingTier          ListingTier?
  pricingUrl           String?
  razorpayOrderId      String?                  @unique
  razorpayPaymentId    String?                  @unique
  referralCode         String?                  @unique
  referredBy           String?
  startupId            String?
  tierExpiresAt        DateTime?
  claimStatus          ClaimStatus              @default(UNCLAIMED)
  claimedAt            DateTime?
  ownerId              String?
  searchVector         Unsupported("tsvector")?
  AffiliateClick       AffiliateClick[]
  ToolCategory         ToolCategory             @relation(fields: [categoryId], references: [id])
  FounderUser          FounderUser?             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  Startup              Startup?                 @relation(fields: [startupId], references: [id])
  Article              Article[]
  ToolCon              ToolCon[]
  ToolPro              ToolPro[]
  ToolReview           ToolReview[]
  ToolTag              ToolTag[]
  ToolTraffic          ToolTraffic[]
  ToolUseCase          ToolUseCase[]
  SavedTool            SavedTool[]
  ToolFeaturedCampaign ToolFeaturedCampaign[]
  ToolSystemTagMapping ToolSystemTagMapping[]
  ToolAlternatives     ToolAlternative[]        @relation("ToolToAlternatives")
  ToolAlternativeOf    ToolAlternative[]        @relation("AlternativeToTools")
  ToolUpvote           ToolUpvote[]

  siteAnnouncements SiteAnnouncement[]

  @@index([avgRating])
  @@index([categoryId])
  @@index([claimStatus])
  @@index([isFeatured, status])
  @@index([ownerId])
  @@index([pricingModel])
  @@index([searchVector], type: Gin)
  @@index([status])
  @@index([status, listingTier])
  @@index([deletedAt])
  @@index([createdAt])
}

model Article {
  id              String                   @id
  title           String
  slug            String                   @unique
  excerpt         String?
  content         Json
  contentText     String?
  type            ArticleType              @default(NEWS)
  status          ArticleStatus            @default(DRAFT)
  authorId        String
  categoryId      String?
  coverImage      String?
  readTimeMinutes Int                      @default(1)
  wordCount       Int                      @default(0)
  viewCount       Int                      @default(0)
  shareCount      Int                      @default(0)
  isFeatured      Boolean                  @default(false)
  isPinned        Boolean                  @default(false)
  isSponsored     Boolean                  @default(false)
  sponsorId       String?
  seoTitle        String?
  seoDescription  String?
  focusKeyword    String?
  ogImage         String?
  canonicalUrl    String?
  noIndex         Boolean                  @default(false)
  schemaType      String?
  scheduledAt     DateTime?
  publishedAt     DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime
  deletedAt       DateTime?
  thumbnailImage  String?
  startupId       String?
  toolId          String?
  likeCount       Int                      @default(0)
  keyTakeaways    Json?
  agreeCount      Int                      @default(0)
  disagreeCount   Int                      @default(0)
  primaryTagId    String?
  searchVector    Unsupported("tsvector")?

  // Founder content fields
  submittedById    String?
  founderAuthorId  String?
  moderationStatus ModerationStatus @default(NONE)
  moderationNote   String?
  moderatedBy      String?
  moderatedAt      DateTime?
  lastSavedAt      DateTime?
  autoSaved        Boolean          @default(false)

  User                                          User                   @relation(fields: [authorId], references: [id])
  Category                                      Category?              @relation(fields: [categoryId], references: [id])
  Startup                                       Startup?               @relation(fields: [startupId], references: [id])
  AiTool                                        AiTool?                @relation(fields: [toolId], references: [id])
  PrimaryTag                                    Tag?                   @relation("ArticlePrimaryTag", fields: [primaryTagId], references: [id], onDelete: SetNull)
  SubmittedByFounder                            FounderUser?           @relation("ArticleSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  FounderAuthor                                 FounderUser?           @relation("ArticleFounderAuthor", fields: [founderAuthorId], references: [id], onDelete: SetNull)
  ArticleCoAuthor                               ArticleCoAuthor[]
  ArticleTag                                    ArticleTag[]
  ArticleVersion                                ArticleVersion[]
  Comment                                       Comment[]
  ContentActivityLog                            ContentActivityLog[]
  ContentMedia                                  ContentMedia[]
  FounderContentReport                          FounderContentReport[]
  RelatedArticle_RelatedArticle_fromIdToArticle RelatedArticle[]       @relation("RelatedArticle_fromIdToArticle")
  RelatedArticle_RelatedArticle_toIdToArticle   RelatedArticle[]       @relation("RelatedArticle_toIdToArticle")

  @@index([authorId])
  @@index([categoryId])
  @@index([isFeatured, status])
  @@index([searchVector], type: Gin)
  @@index([status, publishedAt])
  @@index([type, status])
  @@index([deletedAt])
  @@index([submittedById])
  @@index([founderAuthorId])
  @@index([moderationStatus])
  @@index([type, moderationStatus, status])
  @@index([primaryTagId])
}

model ArticleCoAuthor {
  articleId String
  userId    String
  Article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  User      User    @relation(fields: [userId], references: [id])

  @@id([articleId, userId])
}

model ArticleTag {
  articleId String
  tagId     String
  Article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  Tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model ArticleVersion {
  id            String   @id
  articleId     String
  versionNumber Int      @default(1)
  content       Json
  title         String
  excerpt       String?
  coverImage    String?
  createdBy     String?
  changeNote    String?
  createdAt     DateTime @default(now())
  Article       Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
  @@index([articleId, versionNumber])
}

model AuditLog {
  id           String   @id
  userId       String
  action       String
  resourceType String
  resourceId   String?
  before       Json?
  after        Json?
  ipAddress    String?
  createdAt    DateTime @default(now())
  User         User     @relation(fields: [userId], references: [id])

  @@index([resourceType, createdAt])
  @@index([userId])
}

model BreakingTicker {
  id        String   @id
  text      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([isActive, sortOrder])
}

model Category {
  id             String     @id
  name           String
  slug           String     @unique
  description    String?
  icon           String?
  color          String?
  parentId       String?
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime
  Article        Article[]
  Category       Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  other_Category Category[] @relation("CategoryToCategory")

  @@index([parentId])
}

model CityDeepDive {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cityId                 String?   @db.Uuid
  cityName               String
  slug                   String    @unique
  tagline                String?
  longDescription        String?
  totalStartups          Int?      @default(0)
  totalFunding           BigInt?   @default(0)
  mlEngineers            Int?
  averageSalary          BigInt?
  topStartups            Json?
  keyAccelerators        Json?
  majorCompanies         String[]
  topUniversities        String[]
  coworkingSpaces        String[]
  majorEvents            String[]
  reportPrice            Int?      @default(299900)
  reportUrl              String?
  featuredPlacementPrice Int?      @default(1500000)
  isFeatured             Boolean?  @default(false)
  displayOrder           Int?      @default(0)
  isActive               Boolean?  @default(true)
  createdAt              DateTime? @default(now()) @db.Timestamp(6)
  updatedAt              DateTime? @default(now()) @db.Timestamp(6)
}

model Comment {
  id            String        @id
  articleId     String
  userId        String?
  parentId      String?
  name          String?
  email         String?
  body          String
  status        CommentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  Article       Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  Comment       Comment?      @relation("CommentToComment", fields: [parentId], references: [id])
  other_Comment Comment[]     @relation("CommentToComment")
  User          User?         @relation(fields: [userId], references: [id])

  @@index([articleId, status])
  @@index([parentId])
  @@index([userId])
}

model FeaturedFounder {
  id            String   @id
  name          String
  startupName   String
  startupSlug   String?
  photoUrl      String?
  bio           String
  achievement   String
  fundingRaised String?
  category      String
  linkedinUrl   String?
  twitterUrl    String?
  storyUrl      String?
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([displayOrder])
  @@index([isActive])
}

model FounderAnalytics {
  id            String      @id
  userId        String
  entityType    String
  entityId      String
  date          DateTime    @db.Date
  views         Int         @default(0)
  clicks        Int         @default(0)
  inquiries     Int         @default(0)
  favorites     Int         @default(0)
  shares        Int         @default(0)
  directViews   Int         @default(0)
  searchViews   Int         @default(0)
  socialViews   Int         @default(0)
  referralViews Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  FounderUser   FounderUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId, date])
  @@index([entityType, entityId, date])
  @@index([userId, date])
}

model FounderNotification {
  id          String      @id
  userId      String
  type        String
  title       String
  message     String
  link        String?
  read        Boolean     @default(false)
  createdAt   DateTime    @default(now())
  FounderUser FounderUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, read])
}

model FounderSession {
  id          String      @id
  userId      String
  token       String      @unique
  expiresAt   DateTime
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())
  FounderUser FounderUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model FounderUser {
  id                     String            @id
  email                  String            @unique
  name                   String
  passwordHash           String?
  company                String?
  previousCompany        String?
  role                   String?
  phone                  String?
  avatar                 String?
  bio                    String?
  linkedin               String?
  twitter                String?
  website                String?
  emailVerified          Boolean           @default(false)
  verifyToken            String?           @unique
  resetToken             String?           @unique
  resetExpiry            DateTime?
  status                 FounderUserStatus @default(PENDING_VERIFICATION)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime
  lastLoginAt            DateTime?
  authProvider           String            @default("email")
  companyDomain          String?
  companyEmail           String?
  companyEmailVerified   Boolean           @default(false)
  companyEmailVerifiedAt DateTime?
  googleId               String?           @unique
  onboardingCompleted    Boolean           @default(false)
  onboardingStep         Int               @default(0)
  twoFactorEnabled       Boolean           @default(false)
  twoFactorSecret        String?
  twoFactorBackupCodes   String[]
  failedLoginAttempts    Int               @default(0)
  lockedUntil            DateTime?

  // Email change
  pendingEmail           String?
  emailChangeToken       String?   @unique
  emailChangeTokenExpiry DateTime?

  // Account lifecycle
  deactivatedAt DateTime?
  deletedAt     DateTime?

  // Unified identity link
  unifiedUserId String?      @unique
  unifiedUser   UnifiedUser? @relation("FounderToUnified", fields: [unifiedUserId], references: [id], onDelete: SetNull)

  AiTool                                 AiTool[]
  FounderAnalytics                       FounderAnalytics[]
  FounderNotification                    FounderNotification[]
  FounderSession                         FounderSession[]
  Startup_Startup_claimedByToFounderUser Startup[]                @relation("Startup_claimedByToFounderUser")
  Startup_Startup_ownerIdToFounderUser   Startup[]                @relation("Startup_ownerIdToFounderUser")
  StartupVerificationLog                 StartupVerificationLog[]
  ToolReviewResponse                     ToolReviewResponse[]
  founder_settings                       founder_settings?
  teamMembers                            FounderTeamMember[]
  submittedArticles                      Article[]                @relation("ArticleSubmittedBy")
  authoredArticles                       Article[]                @relation("ArticleFounderAuthor")
  milestones                             FounderMilestone[]
  contentActivityLogs                    ContentActivityLog[]
  advPackages                            AdvPackage[]
  advPayments                            AdvPayment[]
  HiringWorkspaces                       JobBoardEmployer[]

  @@index([companyDomain])
  @@index([status])
  @@index([deactivatedAt])
}

model FundingDigest {
  id          String   @id
  title       String
  date        DateTime @db.Date
  status      String   @default("DRAFT")
  dealsCount  Int      @default(0)
  totalRaised String
  deals       Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([date])
  @@index([status])
}

model FundingRound {
  id            String   @id
  startupId     String
  roundType     String
  amountInr     BigInt
  amountUsd     BigInt?
  announcedAt   DateTime
  leadInvestors String[]
  allInvestors  String[]
  valuation     BigInt?
  sourceUrl     String?
  createdAt     DateTime @default(now())
  Startup       Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)

  siteAnnouncements SiteAnnouncement[]

  @@index([announcedAt])
  @@index([roundType])
  @@index([startupId, announcedAt])
}

model GlossaryTerm {
  id           String   @id
  term         String
  slug         String   @unique
  definition   String
  relatedTerms String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model GovernmentScheme {
  id                  String   @id
  name                String
  shortName           String
  fundingAmount       String
  eligibility         String[]
  applicationDeadline String
  status              String   @default("Open")
  applyLink           String
  description         String
  benefits            String[]
  category            String
  state               String?
  displayOrder        Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([category])
  @@index([displayOrder])
  @@index([isActive])
  @@index([status])
}

model HeroSlot {
  id              String    @id
  title           String?
  ctaUrl          String?
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  articleId       String?
  imageUrl        String?
  subtitle        String?
  authorName      String?
  badgeText       String?
  coverImage      String?
  ctaLabel        String?
  endDate         DateTime?
  excerpt         String?
  readTimeMinutes Int?
  startDate       DateTime?

  @@index([isActive, sortOrder])
}

model IndiaAICity {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cityName         String    @unique
  slug             String    @unique
  state            String?
  latitude         Decimal   @db.Decimal(10, 8)
  longitude        Decimal   @db.Decimal(11, 8)
  totalStartups    Int?      @default(0)
  totalFunding     BigInt?   @default(0)
  topSectors       String[]
  recentFundings   Json?
  keyAccelerators  String[]
  notableCompanies String[]
  averageTeamSize  Int?
  averageFunding   BigInt?
  description      String?
  featuredImage    String?
  isFeatured       Boolean?  @default(false)
  premiumPlacement Boolean?  @default(false)
  premiumUntil     DateTime? @db.Timestamp(6)
  displayOrder     Int?      @default(0)
  isActive         Boolean?  @default(true)
  source           String?   @default("standard")
  aliases          String[]
  createdAt        DateTime? @default(now()) @db.Timestamp(6)
  updatedAt        DateTime? @default(now()) @db.Timestamp(6)

  @@index([isActive, displayOrder], map: "idx_indiaai_city_active")
  @@index([latitude, longitude], map: "idx_indiaai_city_location")
}

model IndiaAIFundingHighlight {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fundingRoundId String?   @db.Uuid
  startupId      String?   @db.Uuid
  isFeatured     Boolean?  @default(false)
  featuredUntil  DateTime? @db.Timestamp(6)
  displayOrder   Int?      @default(0)
  createdAt      DateTime? @default(now()) @db.Timestamp(6)
}

model IndiaAIMissionTracker {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  component       String
  budgetAllocated BigInt
  budgetDisbursed BigInt?   @default(0)
  description     String?
  keyInitiatives  String[]
  displayOrder    Int?      @default(0)
  isActive        Boolean?  @default(true)
  updatedAt       DateTime? @default(now()) @db.Timestamp(6)
}

model IndiaAIStats {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  metricKey    String    @unique
  metricLabel  String
  metricValue  String
  metricChange String?
  metricIcon   String?
  source       String?   @default("manual")
  displayOrder Int?      @default(0)
  isActive     Boolean?  @default(true)
  lastUpdated  DateTime? @default(now()) @db.Timestamp(6)
  createdAt    DateTime? @default(now()) @db.Timestamp(6)
  updatedAt    DateTime? @default(now()) @db.Timestamp(6)
}

model IndianAITool {
  id            String   @id
  name          String
  slug          String   @unique
  tagline       String
  description   String
  logoUrl       String?
  websiteUrl    String
  category      String
  foundedYear   Int?
  fundingStatus String?
  totalFunding  String?
  headquarters  String?
  teamSize      String?
  features      String[]
  useCases      String[]
  isFeatured    Boolean  @default(false)
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([displayOrder])
  @@index([isActive])
  @@index([isFeatured])
}

model Investor {
  id                 String       @id
  name               String
  slug               String       @unique
  type               InvestorType @default(VC)
  websiteUrl         String?
  logoUrl            String?
  description        String?
  focusAreas         String[]
  notableInvestments String[]
  totalDealsIndia    Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime

  @@index([type])
}

model Job {
  id                String    @id
  startupId         String
  title             String
  description       String
  location          String?
  type              JobType   @default(REMOTE)
  salaryRangeMin    Int?
  salaryRangeMax    Int?
  postedBy          String?
  expiresAt         DateTime?
  applicationsCount Int       @default(0)
  isActive          Boolean   @default(true)
  isFeatured        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
  deletedAt         DateTime?
  Startup           Startup   @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([isActive, type])
  @@index([isFeatured])
  @@index([startupId])
}

model JobApplication {
  id              String    @id @default(cuid())
  type            String    @default("INTERNSHIP")
  role            String
  fullName        String
  email           String
  phone           String?
  mobile          String?
  resumeLink      String
  resumeUrl       String?
  resumeFileName  String?
  resumeSizeBytes Int?
  linkedinUrl     String?
  portfolioUrl    String?
  status          String    @default("NEW")
  notes           String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([email, role])
  @@index([createdAt])
  @@index([status])
  @@index([type])
}

model LiveTicker {
  id        String   @id
  text      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([isActive, sortOrder])
}

model MediaAsset {
  id           String   @id @default(cuid())
  key          String   @unique
  prefix       String   @default("uploads")
  url          String   @unique
  originalName String
  slug         String   @default("")
  fileHash     String?
