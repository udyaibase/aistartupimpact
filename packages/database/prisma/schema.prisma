model EventOrganizer {
  id                     String               @id @default(dbgenerated("gen_random_uuid()"))
  email                  String               @unique
  name                   String
  passwordHash           String?
  googleId               String?              @unique
  company                String?
  phone                  String?
  avatar                 String?
  bio                    String?
  website                String?
  linkedin               String?
  emailVerified          Boolean              @default(false)
  verifyToken            String?              @unique
  companyDomain          String?
  companyEmail           String?
  companyEmailVerified   Boolean              @default(false)
  companyEmailVerifiedAt DateTime?
  status                 EventOrganizerStatus @default(PENDING_VERIFICATION)
  /// Verified organizer: an admin approved their first event, so later events publish without review.
  verifiedAt             DateTime?
  /// Suspended by an admin (status SUSPENDED): upcoming events were cancelled and sign-in is blocked.
  suspendedAt            DateTime?
  suspendReason          String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  lastLoginAt            DateTime?

  // 2FA
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String[]
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?

  // Email change
  pendingEmail           String?
  emailChangeToken       String?   @unique
  emailChangeTokenExpiry DateTime?

  // Onboarding
  onboardingCompleted Boolean @default(false)
  onboardingStep      Int     @default(0)

  // Sessions issued before this moment are no longer valid (set when a password changes)
  sessionsValidAfter DateTime?

  // Account lifecycle
  deactivatedAt       DateTime?
  deletedAt           DateTime?
  /// Deletion requested: the account is deactivated and is removed for good at this time unless reactivated.
  deletionScheduledAt DateTime?

  // Plan (Free / Pro). A Pro plan past planExpiresAt counts as Free.
  plan                OrganizerPlan        @default(FREE)
  planExpiresAt       DateTime?
  planReminderSentAt  DateTime?
  billingName         String?
  billingGstin        String?
  billingAddress      String?
  billingState        String?
  /// Billing profile (invoices): GST | BUSINESS (unregistered) | INDIVIDUAL.
  billingType         String?
  billingAddressLine1 String?
  billingAddressLine2 String?
  billingCity         String?
  billingPostalCode   String?
  billingCountry      String?              @default("IN")
  /// Customer's PO / reference number, printed on invoices.
  billingPoNumber     String?
  /// Where invoices, receipts and credit notes are emailed (plus up to 3 CC).
  billingEmail        String?
  billingCcEmails     String[]             @default([])
  /// The free Event Boost on the first published event.
  freeBoostUsedAt     DateTime?
  planGraceNoticeAt   DateTime?
  /// Billing cycle of the current Pro plan.
  planCycle           JobBoardBillingCycle @default(MONTHLY)
  /// First yearly Pro purchase at the founding price (first 20 hosts); the price holds for 24 months.
  foundingMemberAt    DateTime?
  /// Set when Pro lapsed to Free after becoming a founding host: the founding price no longer applies.
  foundingLostAt      DateTime?

  // Payouts for paid tickets (Razorpay Route linked account). Bank details go to Razorpay only.
  payoutAccountId   String?
  payoutProductId   String?
  /// NOT_STARTED | UNDER_REVIEW | NEEDS_CLARIFICATION | ACTIVATED | SUSPENDED
  payoutStatus      String?
  payoutBankLast4   String?
  payoutBeneficiary String?
  payoutNote        String?
  payoutUpdatedAt   DateTime?

  // Unified identity link
  unifiedUserId String?      @unique
  unifiedUser   UnifiedUser? @relation("OrganizerToUnified", fields: [unifiedUserId], references: [id], onDelete: SetNull)

  // Relations
  events       Event[]
  sessions     EventOrganizerSession[]
  teamMembers  EventTeamMember[]
  widgets      EmbedWidget[]
  payments     OrganizerPayment[]
  campaigns    EventEmailCampaign[]
  series       EventSeries[]
  integrations OrganizerIntegration[]

  @@index([status])
  @@index([deactivatedAt])
}

/// A workspace owner handing the workspace to one of its Admins. The Admin accepts from an emailed link; on accept
/// the Admin takes over the workspace's sign-in and the old owner gets an account of their own, kept as an Admin.
model OrganizerOwnershipTransfer {
  id                     String    @id @default(dbgenerated("gen_random_uuid()"))
  /// The workspace (EventOrganizer) being handed over.
  organizerId            String
  /// The Admin's team membership and own account at the time of the request.
  toMemberId             String
  toAccountId            String
  toEmail                String
  /// sha256 of the link token.
  tokenHash              String    @unique
  /// PENDING | ACCEPTED | CANCELLED | EXPIRED
  status                 String    @default("PENDING")
  expiresAt              DateTime
  createdAt              DateTime  @default(now())
  decidedAt              DateTime?
  /// After acceptance: the account the previous owner now signs in with.
  previousOwnerAccountId String?

  @@index([organizerId, status])
}

model EventOrganizerSession {
  id          String         @id @default(dbgenerated("gen_random_uuid()"))
  organizerId String
  token       String         @unique
  expiresAt   DateTime
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime       @default(now())
  /// Last request on this session (updated at most every few minutes), for the signed-in devices list.
  lastSeenAt  DateTime?
  organizer   EventOrganizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([organizerId])
  @@index([expiresAt])
}

