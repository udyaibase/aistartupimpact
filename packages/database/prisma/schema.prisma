/// The owner hands a startup to another founder account. The recipient accepts with a single-use link.
model StartupOwnershipTransfer {
  id          String    @id @default(cuid())
  startupId   String
  fromUserId  String
  toEmail     String
  /// SHA-256 of the link token; the token itself is only in the email.
  tokenHash   String    @unique
  /// PENDING, ACCEPTED, DECLINED, CANCELLED, EXPIRED
  status      String    @default("PENDING")
  expiresAt   DateTime
  respondedAt DateTime?
  toUserId    String?
  createdAt   DateTime  @default(now())
  Startup     Startup   @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId, status])
  @@index([toEmail])
}

