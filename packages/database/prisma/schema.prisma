// ──────────────────────────────────────────────────────────
// Advertise System — Launch Year Packages & Placement Zones
// ──────────────────────────────────────────────────────────

enum AdvPackageTier {
  FREE
  STARTER
  GROWTH
  PREMIUM
}

enum AdvPackageStatus {
  ACTIVE
  EXPIRED
  UPGRADED
  CANCELLED
}

enum AdvZoneTier {
  TIER_1
  TIER_2
  TIER_3
}

enum AdvZoneSlot {
  // Tier 1 — Premium Only
  PROMO_BADGE_HEADER
  HOMEPAGE_HERO
  POWERED_BY_SECTION
  // Tier 2 — Growth & Premium
  FOUNDER_SPOTLIGHT
  FEATURED_PARTNER
  WEBSITE_NEWSLETTER_FEATURED
  LINKEDIN_NEWSLETTER_FEATURED
  // Tier 3 — Starter, Growth & Premium
  LATEST_STORIES_CARD_1
  AI_TOOL_PICKS
  STORIES_PAGE_FEATURED
  AI_TOOLS_PAGE_FEATURED
  STARTUP_DIRECTORY_FEATURED
}

enum AdvActivationStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AdvSocialPostType {
  LINKEDIN
  INSTAGRAM
  BUNDLE
}

enum AdvSocialPostStatus {
  PENDING_PAYMENT
  PAID
  SCHEDULED
  PUBLISHED
  CANCELLED
}

enum AdvPaymentPurpose {
  PACKAGE_PURCHASE
  PACKAGE_UPGRADE
  ZONE_EXTENSION
  SOCIAL_POST
}

model AdvPackage {
  id             String           @id @default(dbgenerated("gen_random_uuid()"))
  founderId      String
  tier           AdvPackageTier
  status         AdvPackageStatus @default(ACTIVE)
  purchasedAt    DateTime         @default(now())
  expiresAt      DateTime
  upgradedFromId String?          @unique
  upgradedToId   String?
  cancelledAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  founder      FounderUser @relation(fields: [founderId], references: [id], onDelete: Cascade)
  upgradedFrom AdvPackage? @relation("PackageUpgrade", fields: [upgradedFromId], references: [id], onDelete: SetNull)
  upgradedTo   AdvPackage? @relation("PackageUpgrade")

  zoneActivations AdvZoneActivation[]
  socialPosts     AdvSocialPostOrder[]
  payments        AdvPayment[]

  @@index([founderId, status])
  @@index([expiresAt])
  @@index([tier, status])
}

model AdvZoneActivation {
  id             String              @id @default(dbgenerated("gen_random_uuid()"))
  packageId      String
  zone           AdvZoneSlot
  zoneTier       AdvZoneTier
  status         AdvActivationStatus @default(SCHEDULED)
  startsAt       DateTime
  endsAt         DateTime
  freeDaysUsed   Int                 @default(3)
  extensionDays  Int                 @default(0)
  extensionRate  Int                 @default(0)
  extensionTotal Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  package  AdvPackage   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  payments AdvPayment[]

  @@unique([packageId, zone])
  @@index([zone, status, startsAt, endsAt])
  @@index([status, endsAt])
}

model AdvSocialPostOrder {
  id           String              @id @default(dbgenerated("gen_random_uuid()"))
  packageId    String
  postType     AdvSocialPostType
  status       AdvSocialPostStatus @default(PENDING_PAYMENT)
  contentBrief String?
  publishedUrl String?
  publishedAt  DateTime?
  amountPaise  Int
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  package  AdvPackage   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  payments AdvPayment[]

  @@index([packageId, status])
  @@index([postType, status])
}

model AdvPayment {
  id                String            @id @default(dbgenerated("gen_random_uuid()"))
  founderId         String
  packageId         String?
  zoneActivationId  String?
  socialPostOrderId String?
  purpose           AdvPaymentPurpose
  amountPaise       Int
  gstPaise          Int
  totalPaise        Int
  currency          String            @default("INR")
  razorpayOrderId   String?           @unique
  razorpayPaymentId String?           @unique
  razorpaySignature String?
  status            PaymentStatus     @default(PENDING)
  paidAt            DateTime?
  failedAt          DateTime?
  refundedAt        DateTime?
  refundAmountPaise Int?
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  founder         FounderUser         @relation(fields: [founderId], references: [id], onDelete: Cascade)
  package         AdvPackage?         @relation(fields: [packageId], references: [id], onDelete: SetNull)
  zoneActivation  AdvZoneActivation?  @relation(fields: [zoneActivationId], references: [id], onDelete: SetNull)
  socialPostOrder AdvSocialPostOrder? @relation(fields: [socialPostOrderId], references: [id], onDelete: SetNull)

  @@index([founderId, status])
  @@index([razorpayOrderId])
  @@index([status, createdAt])
}

model WebUserInterest {
  userId     String
  categoryId String
  user       WebUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   ToolCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([userId])
  @@index([categoryId])
}

model AnalyticsDaily {
  id            String   @id @default(dbgenerated("gen_random_uuid()"))
  entityType    String
  entityId      String
  date          DateTime @db.Date
  views         Int      @default(0)
  clicks        Int      @default(0)
  shares        Int      @default(0)
  directViews   Int      @default(0)
  searchViews   Int      @default(0)
  socialViews   Int      @default(0)
  emailViews    Int      @default(0)
  referralViews Int      @default(0)
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([entityType, entityId, date])
  @@index([entityType, entityId, date])
  @@index([entityType, date])
}

model WebUserInteraction {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  categoryId String?
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz

  user WebUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, entityType, createdAt])
  @@index([entityType, entityId])
  @@index([categoryId])
}

enum JobBoardTeamRole {
  OWNER
  RECRUITER
  INTERVIEWER
}

/// PENDING = invited by an owner; REQUESTED = asked to join (owners approve); DECLINED = request turned down.
enum JobBoardTeamStatus {
  PENDING
  ACTIVE
  REMOVED
  REQUESTED
  DECLINED
}

/// Teammates of an employer hiring workspace. The workspace account itself is the original owner.
model JobBoardTeamMember {
  id              String             @id @default(cuid())
  employerId      String
  email           String
  name            String?
  role            JobBoardTeamRole   @default(RECRUITER)
  /// Monday hiring report email (owners and recruiters only).
  weeklyReport    Boolean            @default(true)
  /// Interviewers only: jobs they can see. Empty = every job.
  jobIds          String[]           @default([])
  status          JobBoardTeamStatus @default(PENDING)
  inviteTokenHash String?            @unique
  inviteExpiresAt DateTime?
  invitedByEmail  String
  invitedAt       DateTime           @default(now())
  acceptedAt      DateTime?
  lastActiveAt    DateTime?
  /// "Sign out everywhere": this person's sessions issued before this moment no longer count.
  sessionsValidAfter DateTime?
  /// Sessions this person signed out of (their ids), so a copied cookie stops working. Newest last, capped.
  revokedSessionIds  String[]        @default([])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  Employer JobBoardEmployer @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@unique([employerId, email])
  @@index([email])
}

enum JobBoardPaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

/// One Razorpay order for a 30-day employer plan period.
model JobBoardPayment {
  id                  String                @id @default(cuid())
  employerId          String
  plan                JobBoardPlan
  cycle               JobBoardBillingCycle  @default(MONTHLY)
  /// Paid at the founding-member price (annual only).
  foundingPrice       Boolean               @default(false)
  amountPaise         Int
  gstPaise            Int
  totalPaise          Int
  razorpayOrderId     String                @unique
  razorpayPaymentId   String?               @unique
  status              JobBoardPaymentStatus @default(PENDING)
  periodStart         DateTime?
  periodEnd           DateTime?
  paidByEmail         String?
  /// Assigned once from InvoiceCounter, so unique by construction.
  invoiceNumber       String?
  /// Bill-to details frozen when the invoice number is assigned; later profile edits never change it.
  billingSnapshot     Json?
  invoiceEmailedAt    DateTime?
  /// GST credit note for a refund (UTPL/CN/<FY>/0001), linked to this payment's invoice.
  creditNoteNumber    String?
  creditNoteAt        DateTime?
  creditNoteEmailedAt DateTime?
  createdAt           DateTime              @default(now())
  paidAt              DateTime?
  failedAt            DateTime?
  /// Set by an admin refund (Razorpay refund id). Status stays SUCCESS; the invoice needs a credit note.
  refundedAt          DateTime?
  refundId            String?
  refundAmountPaise   Int?
  refundReason        String?
  refundedByEmail     String?

  Employer JobBoardEmployer @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@index([employerId, createdAt])
}

enum JobBoardAiScreeningStatus {
  PENDING
  DONE
  FAILED
}

/// AI read of one application against its job (within the plan's monthly quota). A suggestion for the hiring team only;
/// never shown to the candidate and never used to move anyone automatically.
model JobBoardAiScreening {
  id             String                    @id @default(cuid())
  applicationId  String                    @unique
  employerId     String
  status         JobBoardAiScreeningStatus @default(PENDING)
  model          String?
  promptVersion  String?
  /// Hash of the job requirements used, so the portal can say when they changed since.
  jobHash        String?
  fitScore       Int?
  recommendation String?
  result         Json?
  error          String?
  /// Counts against the plan quota (failed runs are refunded by clearing this).
  billable       Boolean                   @default(true)
  createdAt      DateTime                  @default(now())
  completedAt    DateTime?

  Application JobBoardApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  Employer    JobBoardEmployer    @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@index([employerId, createdAt])
}

/// One "invite to apply" email from the talent pool, so a candidate is never invited twice to one job.
model JobBoardTalentInvite {
  id             String   @id @default(cuid())
  applicationId  String
  listingId      String
  invitedByEmail String
  createdAt      DateTime @default(now())

  Application JobBoardApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  Listing     JobBoardListing     @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([applicationId, listingId])
  @@index([listingId])
}

enum OrganizerPlan {
  FREE
  PRO
}

/// Razorpay order for an event host: a 30-day Pro plan or a one-time Event Boost.
model OrganizerPayment {
  id                  String                @id @default(cuid())
  organizerId         String
  kind                String // "PRO" | "BOOST"
  /// Pro only: 30 days or a year.
  cycle               JobBoardBillingCycle  @default(MONTHLY)
  /// Paid at the founding-host price (yearly Pro only).
  foundingPrice       Boolean               @default(false)
  eventId             String?
  amountPaise         Int
  gstPaise            Int
  totalPaise          Int
  razorpayOrderId     String                @unique
  razorpayPaymentId   String?               @unique
  status              JobBoardPaymentStatus @default(PENDING)
  periodStart         DateTime?
  periodEnd           DateTime?
  paidByEmail         String?
  /// Assigned once from InvoiceCounter, so unique by construction.
  invoiceNumber       String?
  /// Bill-to details frozen when the invoice number is assigned; later profile edits never change it.
  billingSnapshot     Json?
  invoiceEmailedAt    DateTime?
  /// GST credit note for a refund (UTPL/CN/<FY>/0001), linked to this payment's invoice.
  creditNoteNumber    String?
  creditNoteAt        DateTime?
  creditNoteEmailedAt DateTime?
  createdAt           DateTime              @default(now())
  paidAt              DateTime?
  failedAt            DateTime?
  refundedAt          DateTime?
  refundId            String?
  refundAmountPaise   Int?
  refundReason        String?
  refundedByEmail     String?

  organizer EventOrganizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([organizerId, createdAt])
}

/// Sequential GST invoice numbers per financial year (April to March), shared by all portals.
/// Paid funding-data downloads (Excel) bought on /funding. No account: the buyer is identified by a verified email.
model FundingDataPurchase {
  id                  String                @id @default(cuid())
  email               String
  /// STARTER | GROWTH | PRO | SCALE | FULL (lib/funding/packs.ts)
  pack                String
  /// Startups in the file; null = every startup (FULL).
  startupLimit        Int?
  /// The buyer's choices (date range, sectors, stages, cities, currency, sheets), reused on every re-download.
  filters             Json
  /// Startups matching the filters when bought, for support questions.
  matchedAtPurchase   Int
  amountPaise         Int
  gstPaise            Int
  totalPaise          Int
  razorpayOrderId     String                @unique
  razorpayPaymentId   String?               @unique
  status              JobBoardPaymentStatus @default(PENDING)
  /// Bill-to entered at checkout (name, state, optional GSTIN), in the billing-profile shape.
  billingDetails      Json
  consentAt           DateTime
  consentText         String
  accessExpiresAt     DateTime?
  downloadCount       Int                   @default(0)
  lastDownloadAt      DateTime?
  invoiceNumber       String?
  billingSnapshot     Json?
  invoiceEmailedAt    DateTime?
  creditNoteNumber    String?
  creditNoteAt        DateTime?
  creditNoteEmailedAt DateTime?
  createdAt           DateTime              @default(now())
  paidAt              DateTime?
  failedAt            DateTime?
  refundedAt          DateTime?
  refundId            String?
  refundAmountPaise   Int?
  refundReason        String?
  refundedByEmail     String?

  @@index([email, createdAt])
  @@index([status, paidAt])
}

model InvoiceCounter {
  fy   String @id
  next Int    @default(1)
}

/// One run of a scheduled job (Vercel cron). Failures and missed runs alert the admins.
model OpsCronRun {
  id         String    @id @default(cuid())
  job        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean?
  error      String?
  summary    Json?

  @@index([job, startedAt])
}

/// One OpenAI call, for cost and failure monitoring. Never stores prompts or outputs.
model OpsAiCall {
  id               String   @id @default(cuid())
  feature          String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  /// Estimated cost in millionths of a US dollar.
  costMicroUsd     Int      @default(0)
  ok               Boolean
  error            String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([feature, createdAt])
}

/// Throttle for admin alerts: one email per key per window.
model OpsAlert {
  key        String   @id
  lastSentAt DateTime
  count      Int      @default(1)
}

/// Candidates who asked to hear when a company opens a role (careers widget / company page). Double opt-in.
model JobBoardCareersSubscriber {
  id             String    @id @default(cuid())
  employerId     String
  email          String
  /// Where they signed up: WIDGET or CAREERS_PAGE.
  source         String    @default("CAREERS_PAGE")
  consentAt      DateTime  @default(now())
  consentText    String
  /// Set when they click the link in the confirmation email; only confirmed subscribers are emailed.
  confirmedAt    DateTime?
  /// sha256 of the token in the confirm and unsubscribe links.
  tokenHash      String    @unique
  unsubscribedAt DateTime?
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())

  Employer JobBoardEmployer @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@unique([employerId, email])
  @@index([employerId, confirmedAt])
}

/// A workspace's connected Zoom or Google account, used to create meeting links. Tokens are encrypted.
model OrganizerIntegration {
  id               String    @id @default(cuid())
  organizerId      String
  /// "zoom" | "google"
  provider         String
  accountEmail     String?
  accessTokenEnc   String
  refreshTokenEnc  String?
  expiresAt        DateTime?
  scope            String?
  /// Set when the provider rejected our tokens; the host needs to connect again.
  needsReconnectAt DateTime?
  connectedBy      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organizer EventOrganizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@unique([organizerId, provider])
}

/// Site visitors' weekly job alerts (a role category and/or city). Double opt-in; one-click unsubscribe.
model JobAlertSubscription {
  id             String    @id @default(cuid())
  email          String
  /// JobBoardCategory value, or null for any role.
  category       String?
  /// Exact city as stored on jobs, or null for anywhere.
  city           String?
  /// "REMOTE" to only get remote jobs; null for any.
  workType       String?
  consentAt      DateTime  @default(now())
  consentText    String
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  /// sha256 of the token in the confirm and unsubscribe links.
  tokenHash      String    @unique
  /// Jobs published after this are "new" for the next email.
  lastSentAt     DateTime?
  createdAt      DateTime  @default(now())

  @@unique([email, category, city, workType])
  @@index([confirmedAt, unsubscribedAt])
}

/// A teammate's (or the workspace account's) personal referral link. Applications through it are tagged REFERRAL.
model JobBoardReferrer {
  id         String   @id @default(cuid())
  employerId String
  /// Short public code in the link (?ref=code).
  code       String   @unique
  /// Whose link: a team member's id, or null for the workspace account itself.
  memberId   String?
  name       String
  email      String
  createdAt  DateTime @default(now())

  Employer     JobBoardEmployer      @relation(fields: [employerId], references: [id], onDelete: Cascade)
  Applications JobBoardApplication[]

  @@unique([employerId, email])
}

/// A private, no-sign-in link that lets a co-founder say yes or no to a job's shortlisted candidates.
model JobBoardShortlistShare {
  id             String    @id @default(cuid())
  employerId     String
  listingId      String
  /// Who the link is for (shown on their votes), e.g. "Rahul (co-founder)".
  sharedWithName String
  createdByEmail String
  /// sha256 of the token in the link.
  tokenHash      String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  lastViewedAt   DateTime?
  createdAt      DateTime  @default(now())

  Employer JobBoardEmployer        @relation(fields: [employerId], references: [id], onDelete: Cascade)
  Votes    JobBoardShortlistVote[]

  @@index([employerId, listingId])
}

model JobBoardShortlistVote {
  id            String   @id @default(cuid())
  shareId       String
  applicationId String
  /// YES | NO | MAYBE
  vote          String
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  Share       JobBoardShortlistShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  Application JobBoardApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([shareId, applicationId])
  @@index([applicationId])
}

/// One interviewer's scorecard for one candidate in one round. Hidden from other interviewers until they submit theirs.
model JobBoardScorecard {
  id             String   @id @default(cuid())
  applicationId  String
  round          String
  authorEmail    String
  authorName     String
  /// { "<skill>": 1..4 } for the job's key skills.
  ratings        Json
  /// YES | NO
  recommendation String
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  Application JobBoardApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, round, authorEmail])
  @@index([applicationId])
}

/// A scheduled interview: time, panel and video link. Sent as a Google Calendar invite when Google is connected,
/// otherwise as an email with a calendar file.
model JobBoardInterview {
  id             String    @id @default(cuid())
  applicationId  String
  round          String
  startAt        DateTime
  endAt          DateTime
  timezone       String    @default("Asia/Kolkata")
  /// Teammates on the panel (emails).
  panelEmails    String[]  @default([])
  meetingUrl     String?
  /// SCHEDULED | CANCELLED
  status         String    @default("SCHEDULED")
  createdByEmail String
  createdAt      DateTime  @default(now())
  cancelledAt    DateTime?

  Application JobBoardApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, startAt])
}

/// First time a workspace reached each onboarding step (sign-up to first live job), for the funnel report.
model JobBoardOnboardingStep {
  id         String   @id @default(cuid())
  employerId String
  /// WORKSPACE_CREATED | FIRST_DRAFT | PUBLISH_BLOCKED | FOUNDER_ASKED | REVIEW_REQUESTED | REVIEW_DECIDED | FIRST_JOB_LIVE | FIRST_APPLICATION
  step       String
  at         DateTime @default(now())
  meta       Json?

  Employer JobBoardEmployer @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@unique([employerId, step])
  @@index([step, at])
}

/// A CSV import of candidates from another tool. Rows wait here while the import runs in chunks, then are cleared.
model JobBoardImport {
  id         String    @id @default(cuid())
  employerId String
  createdBy  String
  fileName   String
  /// RUNNING | DONE | UNDONE
  status     String    @default("RUNNING")
  totalRows  Int
  /// Next row index to process.
  cursor     Int       @default(0)
  created    Int       @default(0)
  skipped    Int       @default(0)
  failed     Int       @default(0)
  /// Cleaned rows to import; emptied when the import finishes.
  rows       Json?
  /// The column, job and stage choices, kept for the report.
  mapping    Json
  /// Problems per row: [{ row, email, reason }], capped.
  problems   Json      @default("[]")
  resumes    Int       @default(0)
  createdAt  DateTime  @default(now())
  finishedAt DateTime?
  undoneAt   DateTime?

  Employer     JobBoardEmployer      @relation(fields: [employerId], references: [id], onDelete: Cascade)
  Applications JobBoardApplication[]

  @@index([employerId, createdAt])
}

/// An assessment sent to a candidate: a take-home, a test on another site, or a live exercise.
model JobBoardAssessment {
  id              String    @id @default(cuid())
  applicationId   String
  /// TAKE_HOME | QUESTIONS | WORK_SAMPLE | EXTERNAL | LIVE
  kind            String
  /// Shown to the candidate, e.g. "Data analysis case study".
  title           String?
  /// Written questions (QUESTIONS), copied from the job's setup when sent.
  questions       Json?
  /// The candidate's answers, in the same order as `questions`.
  answers         Json?
  /// Scoring criteria [{ name, weight }]; when set, the reviewer scores each 1–5 and the total is worked out.
  rubric          Json?
  /// The reviewer's 1–5 per criterion, by name.
  rubricScores    Json?
  /// Links the candidate shared (repo, Figma, Drive, video).
  submissionLinks String[]  @default([])
  /// sha256 of the token in the candidate's submission link (take-home only).
  tokenHash       String?   @unique
  brief           String?
  url             String?
  dueAt           DateTime?
  remindedAt      DateTime?
  submittedAt     DateTime?
  submissionUrl   String?
  submissionKey   String?
  submissionNote  String?
  score           Float?
  maxScore        Float?
  /// Advisory only: highlights, never decides.
  passMark        Float?
  reviewerEmail   String?
  reviewNotes     String?
  reviewedAt      DateTime?
  /// SENT | SUBMITTED | REVIEWED | CANCELLED
  status          String    @default("SENT")
  createdByEmail  String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  Application JobBoardApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([status, dueAt])
}

/// The final decision on a candidate, with the one-line reason.
model JobBoardDecision {
  id            String   @id @default(cuid())
  applicationId String
  /// PROCEED | REJECT | BACKUP
  decision      String
  reason        String
  decidedBy     String
  createdAt     DateTime @default(now())

  Application JobBoardApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

/// An offer the team records (no letter): amount, joining date, answer-by date, and how it ended.
model JobBoardOffer {
  id             String    @id @default(cuid())
  applicationId  String
  employerId     String
  /// DRAFT | SENT | ACCEPTED | DECLINED | EXPIRED | WITHDRAWN
  status         String    @default("DRAFT")
  currency       String    @default("INR")
  fixedAnnual    Int?
  variableAnnual Int?
  joiningDate    DateTime?
  answerBy       DateTime?
  /// The employer told the candidate the offer lapses on answerBy; otherwise a missed date only shows "Response overdue".
  firmExpiry     Boolean   @default(false)
  notes          String?
  sentAt         DateTime?
  respondedAt    DateTime?
  declineReason  String?
  reasonBy       String?
  /// Earlier amounts: [{ at, by, fixedAnnual, variableAnnual, joiningDate }]
  revisions      Json      @default("[]")
  createdByEmail String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  Application JobBoardApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([employerId, status])
}

/// A company's own pipeline template ("AI engineering", "Sales"). Jobs copy its setup, so edits affect new jobs only.
model JobBoardPipelineTemplate {
  id         String    @id @default(cuid())
  employerId String
  name       String
  version    Int       @default(1)
  /// { assessment: {...} | null, rounds: string[] }
  config     Json
  createdBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  Employer JobBoardEmployer @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@index([employerId])
}
