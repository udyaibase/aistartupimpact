  @@index([isActive, sortOrder])
}

// ──────────────────────────────────────────────────────────
// Advertise System — Launch Year Packages & Placement Zones
// ──────────────────────────────────────────────────────────

enum AdvPackageTier {
  FREE
  STARTER
  GROWTH
  PREMIUM
}

enum AdvPackageStatus {
  ACTIVE
  EXPIRED
  UPGRADED
  CANCELLED
}

enum AdvZoneTier {
  TIER_1
  TIER_2
  TIER_3
}

enum AdvZoneSlot {
  // Tier 1 — Premium Only
  PROMO_BADGE_HEADER
  HOMEPAGE_HERO
  POWERED_BY_SECTION
  // Tier 2 — Growth & Premium
  FOUNDER_SPOTLIGHT
  FEATURED_PARTNER
  WEBSITE_NEWSLETTER_FEATURED
  LINKEDIN_NEWSLETTER_FEATURED
  // Tier 3 — Starter, Growth & Premium
  LATEST_STORIES_CARD_1
  AI_TOOL_PICKS
  STORIES_PAGE_FEATURED
  AI_TOOLS_PAGE_FEATURED
  STARTUP_DIRECTORY_FEATURED
}

enum AdvActivationStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AdvSocialPostType {
  LINKEDIN
  INSTAGRAM
  BUNDLE
}

enum AdvSocialPostStatus {
  PENDING_PAYMENT
  PAID
  SCHEDULED
  PUBLISHED
  CANCELLED
}

enum AdvPaymentPurpose {
  PACKAGE_PURCHASE
  PACKAGE_UPGRADE
  ZONE_EXTENSION
  SOCIAL_POST
}

model AdvPackage {
  id             String           @id @default(dbgenerated("gen_random_uuid()"))
  founderId      String
  tier           AdvPackageTier
  status         AdvPackageStatus @default(ACTIVE)
  purchasedAt    DateTime         @default(now())
  expiresAt      DateTime
  upgradedFromId String?          @unique
  upgradedToId   String?
  cancelledAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  founder      FounderUser @relation(fields: [founderId], references: [id], onDelete: Cascade)
  upgradedFrom AdvPackage? @relation("PackageUpgrade", fields: [upgradedFromId], references: [id], onDelete: SetNull)
  upgradedTo   AdvPackage? @relation("PackageUpgrade")

  zoneActivations AdvZoneActivation[]
  socialPosts     AdvSocialPostOrder[]
  payments        AdvPayment[]

  @@index([founderId, status])
  @@index([expiresAt])
  @@index([tier, status])
}

model AdvZoneActivation {
  id             String              @id @default(dbgenerated("gen_random_uuid()"))
  packageId      String
  zone           AdvZoneSlot
  zoneTier       AdvZoneTier
  status         AdvActivationStatus @default(SCHEDULED)
  startsAt       DateTime
  endsAt         DateTime
  freeDaysUsed   Int                 @default(3)
  extensionDays  Int                 @default(0)
  extensionRate  Int                 @default(0)
  extensionTotal Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  package  AdvPackage   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  payments AdvPayment[]

  @@unique([packageId, zone])
  @@index([zone, status, startsAt, endsAt])
  @@index([status, endsAt])
}

model AdvSocialPostOrder {
  id           String              @id @default(dbgenerated("gen_random_uuid()"))
  packageId    String
  postType     AdvSocialPostType
  status       AdvSocialPostStatus @default(PENDING_PAYMENT)
  contentBrief String?
  publishedUrl String?
  publishedAt  DateTime?
  amountPaise  Int
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  package  AdvPackage   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  payments AdvPayment[]

  @@index([packageId, status])
  @@index([postType, status])
}

model AdvPayment {
  id                String            @id @default(dbgenerated("gen_random_uuid()"))
  founderId         String
  packageId         String?
  zoneActivationId  String?
  socialPostOrderId String?
  purpose           AdvPaymentPurpose
  amountPaise       Int
  gstPaise          Int
  totalPaise        Int
  currency          String            @default("INR")
  razorpayOrderId   String?           @unique
  razorpayPaymentId String?           @unique
  razorpaySignature String?
  status            PaymentStatus     @default(PENDING)
  paidAt            DateTime?
  failedAt          DateTime?
  refundedAt        DateTime?
  refundAmountPaise Int?
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  founder         FounderUser         @relation(fields: [founderId], references: [id], onDelete: Cascade)
  package         AdvPackage?         @relation(fields: [packageId], references: [id], onDelete: SetNull)
  zoneActivation  AdvZoneActivation?  @relation(fields: [zoneActivationId], references: [id], onDelete: SetNull)
  socialPostOrder AdvSocialPostOrder? @relation(fields: [socialPostOrderId], references: [id], onDelete: SetNull)

  @@index([founderId, status])
  @@index([razorpayOrderId])
  @@index([status, createdAt])
}

model WebUserInterest {
  userId     String
  categoryId String
  user       WebUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   ToolCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([userId])
  @@index([categoryId])
}

model AnalyticsDaily {
  id            String   @id @default(dbgenerated("gen_random_uuid()"))
  entityType    String
  entityId      String
  date          DateTime @db.Date
  views         Int      @default(0)
  clicks        Int      @default(0)
  shares        Int      @default(0)
  directViews   Int      @default(0)
  searchViews   Int      @default(0)
  socialViews   Int      @default(0)
  emailViews    Int      @default(0)
  referralViews Int      @default(0)
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([entityType, entityId, date])
  @@index([entityType, entityId, date])
  @@index([entityType, date])
}

model WebUserInteraction {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  categoryId String?
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz

  user WebUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, entityType, createdAt])
  @@index([entityType, entityId])
  @@index([categoryId])
}

enum JobBoardTeamRole {
  OWNER
  RECRUITER
  INTERVIEWER
}

enum JobBoardTeamStatus {
  PENDING
  ACTIVE
  REMOVED
}

/// Teammates of an employer hiring workspace. The workspace account itself is the original owner.
model JobBoardTeamMember {
  id              String             @id @default(cuid())
  employerId      String
  email           String
  name            String?
  role            JobBoardTeamRole   @default(RECRUITER)
  /// Interviewers only: jobs they can see. Empty = every job.
  jobIds          String[]           @default([])
  status          JobBoardTeamStatus @default(PENDING)
  inviteTokenHash String?            @unique
  inviteExpiresAt DateTime?
  invitedByEmail  String
  invitedAt       DateTime           @default(now())
  acceptedAt      DateTime?
  lastActiveAt    DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  Employer JobBoardEmployer @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@unique([employerId, email])
  @@index([email])
}

enum JobBoardPaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

/// One Razorpay order for a 30-day employer plan period.
model JobBoardPayment {
  id                  String                @id @default(cuid())
  employerId          String
  plan                JobBoardPlan
  amountPaise         Int
  gstPaise            Int
  totalPaise          Int
  razorpayOrderId     String                @unique
  razorpayPaymentId   String?               @unique
  status              JobBoardPaymentStatus @default(PENDING)
  periodStart         DateTime?
  periodEnd           DateTime?
  paidByEmail         String?
  /// Assigned once from InvoiceCounter, so unique by construction.
  invoiceNumber       String?
  /// Bill-to details frozen when the invoice number is assigned; later profile edits never change it.
  billingSnapshot     Json?
  invoiceEmailedAt    DateTime?
  /// GST credit note for a refund (UTPL/CN/<FY>/0001), linked to this payment's invoice.
  creditNoteNumber    String?
  creditNoteAt        DateTime?
  creditNoteEmailedAt DateTime?
  createdAt           DateTime              @default(now())
  paidAt              DateTime?
  failedAt            DateTime?
  /// Set by an admin refund (Razorpay refund id). Status stays SUCCESS; the invoice needs a credit note.
  refundedAt          DateTime?
  refundId            String?
  refundAmountPaise   Int?
  refundReason        String?
  refundedByEmail     String?

  Employer JobBoardEmployer @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@index([employerId, createdAt])
}

enum JobBoardAiScreeningStatus {
  PENDING
  DONE
  FAILED
}

/// AI read of one application against its job (paid plans). A suggestion for the hiring team only;
/// never shown to the candidate and never used to move anyone automatically.
model JobBoardAiScreening {
  id             String                    @id @default(cuid())
  applicationId  String                    @unique
  employerId     String
  status         JobBoardAiScreeningStatus @default(PENDING)
  model          String?
  promptVersion  String?
  /// Hash of the job requirements used, so the portal can say when they changed since.
  jobHash        String?
  fitScore       Int?
  recommendation String?
  result         Json?
  error          String?
  /// Counts against the plan quota (failed runs are refunded by clearing this).
  billable       Boolean                   @default(true)
  createdAt      DateTime                  @default(now())
  completedAt    DateTime?

  Application JobBoardApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  Employer    JobBoardEmployer    @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@index([employerId, createdAt])
}

/// One "invite to apply" email from the talent pool, so a candidate is never invited twice to one job.
model JobBoardTalentInvite {
  id             String   @id @default(cuid())
  applicationId  String
  listingId      String
  invitedByEmail String
  createdAt      DateTime @default(now())

  Application JobBoardApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  Listing     JobBoardListing     @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([applicationId, listingId])
  @@index([listingId])
}

enum OrganizerPlan {
  FREE
  PRO
}

/// Razorpay order for an event host: a 30-day Pro plan or a one-time Event Boost.
model OrganizerPayment {
  id                  String                @id @default(cuid())
  organizerId         String
  kind                String // "PRO" | "BOOST"
  eventId             String?
  amountPaise         Int
  gstPaise            Int
  totalPaise          Int
  razorpayOrderId     String                @unique
  razorpayPaymentId   String?               @unique
  status              JobBoardPaymentStatus @default(PENDING)
  periodStart         DateTime?
  periodEnd           DateTime?
  paidByEmail         String?
  /// Assigned once from InvoiceCounter, so unique by construction.
  invoiceNumber       String?
  /// Bill-to details frozen when the invoice number is assigned; later profile edits never change it.
  billingSnapshot     Json?
  invoiceEmailedAt    DateTime?
  /// GST credit note for a refund (UTPL/CN/<FY>/0001), linked to this payment's invoice.
  creditNoteNumber    String?
  creditNoteAt        DateTime?
  creditNoteEmailedAt DateTime?
  createdAt           DateTime              @default(now())
  paidAt              DateTime?
  failedAt            DateTime?
  refundedAt          DateTime?
  refundId            String?
  refundAmountPaise   Int?
  refundReason        String?
  refundedByEmail     String?

  organizer EventOrganizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([organizerId, createdAt])
}

/// Sequential GST invoice numbers per financial year (April to March), shared by all portals.
model InvoiceCounter {
  fy   String @id
  next Int    @default(1)
}

/// One run of a scheduled job (Vercel cron). Failures and missed runs alert the admins.
model OpsCronRun {
  id         String    @id @default(cuid())
  job        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean?
  error      String?
  summary    Json?

  @@index([job, startedAt])
}

/// One OpenAI call, for cost and failure monitoring. Never stores prompts or outputs.
model OpsAiCall {
  id               String   @id @default(cuid())
  feature          String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  /// Estimated cost in millionths of a US dollar.
  costMicroUsd     Int      @default(0)
  ok               Boolean
  error            String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([feature, createdAt])
}

/// Throttle for admin alerts: one email per key per window.
model OpsAlert {
  key        String   @id
  lastSentAt DateTime
  count      Int      @default(1)
}
