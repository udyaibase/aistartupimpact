enum EventOrganizerStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum TeamRole {
  ADMIN
  MANAGER
  STAFF
  CHECK_IN
}

enum TeamMemberStatus {
  PENDING
  ACTIVE
  REVOKED
}

