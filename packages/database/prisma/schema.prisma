  headingAlign      String    @default("left")
  headingSize       String    @default("md")
  textScale         String    @default("md")
  buttonSize        String    @default("md")
  buttonStyle       String    @default("filled")
  cardStyle         String    @default("bordered")
  spacing           String    @default("comfortable")
  maxJobs           Int       @default(20)
  showLogo          Boolean   @default(true)
  showDepartment    Boolean   @default(true)
  showSalary        Boolean   @default(true)
  showSkills        Boolean   @default(true)
  platform          String?
  setupStartedAt    DateTime?
  codeCopiedAt      DateTime?
  markedInstalledAt DateTime?
  firstSeenAt       DateTime?
