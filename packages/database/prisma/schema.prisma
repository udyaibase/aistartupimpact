// ============================================================
// UNIFIED IDENTITY (single sign-in across all workspaces)
// ============================================================

enum LastWorkspace {
  COMMUNITY
  FOUNDER
  ORGANIZER
}

model UnifiedUser {
  id            String  @id @default(dbgenerated("gen_random_uuid()"))
  email         String  @unique
  name          String
  passwordHash  String?
  googleId      String? @unique
  avatar        String?
  emailVerified Boolean @default(false)
  verifyToken   String? @unique

  // Smart routing
  lastWorkspace LastWorkspace @default(COMMUNITY)

  // 2FA
  twoFactorEnabled     Boolean  @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String[]
  twoFactorInherited   Boolean  @default(false) // true = 2FA was linked from founder account

  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  sessions  UnifiedSession[]
  linkLogs  WorkspaceLinkLog[]

  // Inverse relations (workspace profiles point to this user)
  founderProfile   FounderUser?    @relation("FounderToUnified")
  organizerProfile EventOrganizer? @relation("OrganizerToUnified")
}

model UnifiedSession {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  source    String   @default("direct") // direct | migrated_founder | migrated_organizer | migrated_web
  createdAt DateTime @default(now())

  user UnifiedUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model WorkspaceLinkLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  userId     String
  workspace  String // "founder" | "organizer"
  action     String // "created_fresh" | "linked_existing" | "auto_migrated"
  linkedId   String
  emailMatch Boolean  @default(true)
  verified   Boolean  @default(false)
  ipAddress  String?
  createdAt  DateTime @default(now())

  user UnifiedUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// Pending workspace link requests (for high-value accounts requiring confirmation)
model WorkspaceLinkRequest {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  userId    String
  workspace String // "founder" | "organizer"
  targetId  String // FounderUser.id or EventOrganizer.id to link
  token     String   @unique
  status    String   @default("PENDING") // PENDING | CONFIRMED | EXPIRED | REJECTED
  expiresAt DateTime // 72 hours TTL
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
  @@index([status, expiresAt])
}

