model Startup {
  id                                         String                     @id
  name                                       String
  slug                                       String                     @unique
  slugChangedAt                              DateTime?
  previousSlugs                              String[]                   @default([])
  tagline                                    String
  description                                String
  logoUrl                                    String?
  websiteUrl                                 String?
  linkedinUrl                                String?
  twitterUrl                                 String?
  foundedYear                                Int?
  headquartersCity                           String?
  cityId                                     String?
  stage                                      StartupStage               @default(SEED)
  totalFundingInr                            BigInt                     @default(0)
  employeeCount                              Int?
  isIndian                                   Boolean                    @default(true)
  isFeatured                                 Boolean                    @default(false)
  featuredUntil                              DateTime?
  statValue                                  String?
  statLabel                                  String?
  impactScore                                Int                        @default(0)
  createdAt                                  DateTime                   @default(now())
  updatedAt                                  DateTime
  deletedAt                                  DateTime?
  founders                                   String[]                   @default([])
  foundersData                               Json?
  socialLinks                                Json?
  claimStatus                                ClaimStatus                @default(UNCLAIMED)
  claimedAt                                  DateTime?
  ownerId                                    String?
  submittedBy                                String?
  isVerified                                 Boolean                    @default(false)
  isApproved                                 Boolean                    @default(false)
  contentReviewed                            Boolean                    @default(false)
  approvedAt                                 DateTime?
  verifiedAt                                 DateTime?
  verificationToken                          String?                    @unique
  verifiedDomain                             String?
  /// Private contact email for the startup (admin and platform emails only, never shown publicly).
  contactEmail                               String?
  /// When the founder proved they receive mail at contactEmail (6-digit code, or it is their own verified sign-in email).
  contactEmailVerifiedAt                     DateTime?
  /// How ownership was last proven: DNS or EMAIL. DNS is the stronger proof and can take over an EMAIL verification.
  verificationMethod                         String?
  /// The work email used when verificationMethod is EMAIL (private, for audits and disputes).
  verifiedEmail                              String?
  /// Verification lapses at this time unless renewed (DNS records are re-checked and renew automatically).
  verificationExpiresAt                      DateTime?
  /// Last automatic DNS re-check.
  verificationCheckedAt                      DateTime?
  /// Last expiry reminder sent to the owner (30 and 7 days before).
  verificationRemindedAt                     DateTime?
  /// Weekly DNS re-checks in a row that didn't find the record (lookups fail now and then; acted on at 3).
  verificationDnsMisses                      Int                        @default(0)
  claimedBy                                  String?
  searchVector                               Unsupported("tsvector")?
  category                                   String?                    @db.VarChar(100)
  businessType                               String?
  status                                     CompanyStatus              @default(ACTIVE)
  Event                                      Event[]
  AiTool                                     AiTool[]
  Article                                    Article[]
  FundingRound                               FundingRound[]
  ArticleMentions                            ArticleStartupMention[]
  Job                                        Job[]
  StartupReview                              StartupReview[]
  SavedStartup                               SavedStartup[]
  StartupFAQ                                 StartupFAQ[]
  FounderUser_Startup_claimedByToFounderUser FounderUser?               @relation("Startup_claimedByToFounderUser", fields: [claimedBy], references: [id], onDelete: SetNull)
  FounderUser_Startup_ownerIdToFounderUser   FounderUser?               @relation("Startup_ownerIdToFounderUser", fields: [ownerId], references: [id], onDelete: Cascade)
  City                                       City?                      @relation(fields: [cityId], references: [id])
  StartupVerificationLog                     StartupVerificationLog[]
  ownershipTransfers                         StartupOwnershipTransfer[]
  FeaturedCampaign                           FeaturedCampaign[]
  JobBoardEmployer                           JobBoardEmployer?
  JobBoardListings                           JobBoardListing[]
  FounderMilestone                           FounderMilestone[]
  ContentActivityLog                         ContentActivityLog[]
  ContentMedia                               ContentMedia[]

  siteAnnouncements SiteAnnouncement[]

  @@index([category])
  @@index([cityId])
  @@index([claimStatus])
  @@index([claimedBy])
  @@index([impactScore])
  @@index([isApproved])
  @@index([isFeatured])
  @@index([isIndian])
  @@index([isVerified])
  @@index([ownerId])
  @@index([searchVector], type: Gin)
  @@index([stage])
  @@index([deletedAt, isApproved, createdAt(sort: Desc)])
  @@index([headquartersCity])
  @@index([status])
  @@index([businessType])
  @@index([employeeCount])
  @@index([createdAt])
}

