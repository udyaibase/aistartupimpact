  fundingRound FundingRound?    @relation(fields: [fundingRoundId], references: [id], onDelete: SetNull)
  event        Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  jobListing   JobBoardListing? @relation(fields: [jobListingId], references: [id], onDelete: SetNull)
