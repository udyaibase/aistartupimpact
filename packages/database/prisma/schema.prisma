enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING_USER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportTicketCategory {
  ACCOUNT
  BILLING
  BUG_REPORT
  FEATURE_REQUEST
  LISTING
  EVENT
  JOB_BOARD
  OTHER
}

enum SupportTicketPortal {
  FOUNDER
  ORGANIZER
  EMPLOYER
  PUBLIC
}

model SupportTicket {
  id             String                 @id @default(dbgenerated("gen_random_uuid()"))
  ticketNumber   String                 @unique
  subject        String
  description    String
  category       SupportTicketCategory  @default(OTHER)
  priority       SupportTicketPriority  @default(MEDIUM)
  status         SupportTicketStatus    @default(OPEN)
  portal         SupportTicketPortal
  submitterType  String
  submitterId    String
  submitterEmail String
  submitterName  String
  assignedTo     String?
  resolvedAt     DateTime?
  resolvedBy     String?
  closedAt       DateTime?
  /// Where the person was when they reported it (page, job, plan, browser). Employer portal only for now.
  context        Json?
  /// The plan when opened, which sets the reply-time promise.
  planAtOpen     String?
  /// First reply due by (working hours Mon–Sat 9:30–18:30 IST, see apps/web/lib/support/reply-times.ts).
  replyDueAt     DateTime?
  /// First reply from our team (not counting internal notes).
  firstReplyAt   DateTime?
  /// The inbound email it came from (Resend email id), so a retried webhook can\'t open it twice.
  externalId     String?                @unique
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  messages       SupportTicketMessage[]

  @@index([status])
  @@index([priority])
  @@index([portal])
  @@index([submitterType, submitterId])
  @@index([assignedTo])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([portal, createdAt])
  @@index([priority, createdAt])
  @@index([submitterType, submitterId, createdAt])
  @@index([firstReplyAt, replyDueAt])
}

model SupportTicketMessage {
  id         String        @id @default(dbgenerated("gen_random_uuid()"))
  ticketId   String
  senderType String
  senderId   String
  senderName String
  body       String
  isInternal Boolean       @default(false)
  /// The inbound email reply it came from (Resend email id).
  externalId String?       @unique
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

