  deactivatedAt DateTime?
  deletedAt     DateTime?

  // Proven ownership of `email` (Google sign-in or an email code). Past job applications sent with this email
  // are linked to the account only once this is set.
  emailVerifiedAt DateTime? @db.Timestamptz

  // Onboarding
  onboardingCompleted Boolean @default(false)
  onboardingStep      Int     @default(0)
  onboardingVersion   Int     @default(1)

  // Explicit preferences
  primaryIntent        String?
  cityId               String?
  city                 City?     @relation(fields: [cityId], references: [id])
  preferencesUpdatedAt DateTime? @db.Timestamptz

