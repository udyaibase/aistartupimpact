  HACKATHON
  SUMMIT
  WORKSHOP
  MEETUP
  DEMO_DAY
  WEBINAR
  NETWORKING
}

enum EventFormat {
  IN_PERSON
  VIRTUAL
  HYBRID
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  POSTPONED
  COMPLETED
  ARCHIVED
}

enum EventVisibility {
  PUBLIC
  UNLISTED
  INVITE_ONLY
}

enum RegistrationStatus {
  CONFIRMED
  PENDING_APPROVAL
  PENDING_PAYMENT
  WAITLISTED
  CANCELLED
  CHECKED_IN
}

enum TicketTierType {
  EARLY_BIRD
  REGULAR
  VIP
}

enum EventCustomQuestionType {
  TEXT
  SELECT
  CHECKBOX
}

enum EventCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

model Event {
  id                          String          @id @default(dbgenerated("gen_random_uuid()"))
  slug                        String          @unique
  shortCode                   String          @unique // Immutable 6-char code for short URLs (/e/KX7M4P)
  organizerId                 String
  title                       String
  subtitle                    String?
  category                    EventCategory
  format                      EventFormat
  status                      EventStatus     @default(DRAFT)
  // Date & Time
  startAt                     DateTime
  endAt                       DateTime
  timezone                    String          @default("Asia/Kolkata")
  // Location (in-person/hybrid)
  venueName                   String?
  address                     String?
  latitude                    Float?
  longitude                   Float?
  // Virtual (virtual/hybrid)
  meetingLink                 String?
  revealLinkAfterRegistration Boolean         @default(false)
  // Content
  coverImageUrl               String?
  galleryImageUrls            String[]        @default([])
  description                 Json? // Rich text (Tiptap JSON)
  // Capacity & Registration
  capacity                    Int?
  /// Featured on Udyaibase Events until this time (Event Boost or Pro plan).
  featuredUntil               DateTime?
  /// One-time Event Boost purchased: higher registration limit for this event.
  boostedAt                   DateTime?
  /// First time registrations hit the host plan limit; the host is emailed once. Cleared when the limit rises.
  planLimitNotifiedAt         DateTime?
  /// Promo emails left that came with an Event Boost.
  promoCredits                Int             @default(0)
  registrationCount           Int             @default(0)
  visibility                  EventVisibility @default(PUBLIC)
  registrationDeadline        DateTime?
  approvalRequired            Boolean         @default(false)
  // SEO & Sharing
  metaTitle                   String?
  metaDescription             String?
  socialImageUrl              String?
  // External / scraped event
  sourceUrl                   String? // Original URL for scraped events; null = native Udyaibase event
  sourceName                  String? // e.g. "Luma", "Eventbrite", "Meetup"
  // Publishing
  publishAt                   DateTime? // Scheduled publish
  publishedAt                 DateTime?
  // Soft delete
  deletedAt                   DateTime?
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt

  // Relations
  organizer       EventOrganizer        @relation(fields: [organizerId], references: [id])
  speakers        EventSpeaker[]
  agendaItems     EventAgendaItem[]
  ticketTiers     EventTicketTier[]
  customQuestions EventCustomQuestion[]
  registrations   EventRegistration[]
  tags            EventTagMapping[]
  campaigns       EventEmailCampaign[]
  slugHistory     EventSlugHistory[]
  teamAssignments EventTeamAssignment[]

  siteAnnouncements SiteAnnouncement[]

  @@index([status, visibility])
  @@index([startAt])
  @@index([organizerId])
  @@index([category])
  @@index([format])
  @@index([latitude, longitude])
  @@index([deletedAt])
}

model EventSlugHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  eventId   String
  oldSlug   String   @unique // Prevents reuse of old slugs by other events
  newSlug   String
  changedBy String // Organizer ID who made the change
  changedAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventSpeaker {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  eventId     String
  name        String
  title       String?
  company     String?
  headshotUrl String?
  bio         String?
  talkTitle   String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  agendaItems EventAgendaItem[]

  @@index([eventId])
}

model EventAgendaItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  eventId     String
  speakerId   String?
  dayNumber   Int      @default(1)
  startTime   String // "09:00" format for flexible time display
  endTime     String // "10:00"
  title       String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event   Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speaker EventSpeaker? @relation(fields: [speakerId], references: [id], onDelete: SetNull)

  @@index([eventId, dayNumber])
}

model EventTicketTier {
  id          String         @id @default(dbgenerated("gen_random_uuid()"))
  eventId     String
  name        String
  priceCents  Int            @default(0) // 0 = free
  quantity    Int? // null = unlimited
  soldCount   Int            @default(0)
  saleStart   DateTime?
  saleEnd     DateTime?
  tierType    TicketTierType @default(REGULAR)
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]

  @@index([eventId])
}

model EventCustomQuestion {
  id           String                  @id @default(dbgenerated("gen_random_uuid()"))
  eventId      String
  questionText String
  questionType EventCustomQuestionType @default(TEXT)
  options      Json? // For SELECT type: ["Option A", "Option B"]
  required     Boolean                 @default(false)
  sortOrder    Int                     @default(0)
  createdAt    DateTime                @default(now())

  event   Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers EventRegistrationAnswer[]

  @@index([eventId])
}

model EventRegistration {
  id                    String             @id @default(dbgenerated("gen_random_uuid()"))
  eventId               String
  userId                String? // nullable for guest registrations
  ticketTierId          String?
  // Guest info (for non-logged-in registrants)
  guestName             String?
  guestEmail            String?
  guestPhone            String?
  guestCompany          String?
  guestRole             String?
  guestOccupation       String?
  // Consent flags
  whatsappConsent       Boolean            @default(false)
  registrationSource    String             @default("WEBSITE") // WEBSITE | EMBED | EVENT_QR | WALK_IN
  // Embed attribution
  referrerUrl           String?
  embedWidgetId         String?
  utmSource             String?
  utmMedium             String?
  utmCampaign           String?
  // Status & tokens
  status                RegistrationStatus @default(CONFIRMED)
  qrToken               String             @unique // 16-char base62
  // Payment (paid tickets via Razorpay Route)
  stripePaymentIntentId String?
  razorpayOrderId       String?
  razorpayPaymentId     String?
  /// PENDING | PAID | FAILED | EXPIRED | REFUNDED
  paymentStatus         String?
  amountPaise           Int?
  /// Udyaibase's share; the rest is transferred to the host's linked account.
  platformFeePaise      Int?
  /// Unpaid seat hold ends here.
  paymentExpiresAt      DateTime?
  /// Why this person was waitlisted: "plan_limit" (host plan cap) or "capacity" (host-set capacity).
  waitlistReason        String?
  paidAt                DateTime?
  refundId              String?
  refundedAt            DateTime?
  // Timestamps
  registeredAt          DateTime           @default(now())
  checkedInAt           DateTime?
  cancelledAt           DateTime?
  deletedAt             DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  // Relations
  event       Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTier  EventTicketTier?          @relation(fields: [ticketTierId], references: [id], onDelete: SetNull)
  embedWidget EmbedWidget?              @relation(fields: [embedWidgetId], references: [id], onDelete: SetNull)
  answers     EventRegistrationAnswer[]

  @@unique([eventId, guestEmail]) // Prevent duplicate registrations by email per event
  @@index([eventId])
  @@index([embedWidgetId])
  @@index([userId])
  @@index([qrToken])
  @@index([status])
  @@index([deletedAt])
  @@index([razorpayOrderId])
}

model EventRegistrationAnswer {
  id             String @id @default(dbgenerated("gen_random_uuid()"))
  registrationId String
  questionId     String
  answerText     String

  registration EventRegistration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  question     EventCustomQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([questionId])
}

// ============================================================
// EVENT NEWSLETTER & GEO-TARGETING
// ============================================================

model EventTag {
  id            String   @id @default(dbgenerated("gen_random_uuid()"))
  name          String   @unique // Display name: "LLM"
  canonicalName String // Normalized: "large-language-models"
  category      String? // "technology", "domain", "format"
  createdAt     DateTime @default(now())

  eventMappings       EventTagMapping[]
  subscriberInterests EventSubscriberInterest[]

  @@index([canonicalName])
  @@index([category])
}

model EventTagMapping {
  eventId String
  tagId   String

  event Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tag   EventTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([eventId, tagId])
}

model EventSubscriber {
  id                  String    @id @default(dbgenerated("gen_random_uuid()"))
  email               String    @unique
  name                String?
  // Location for geo-targeting
  locationCity        String? // "Hyderabad, India"
  locationLat         Float?
  locationLng         Float?
  locationCountryCode String? // "IN"
  locationRegion      String? // "Telangana"
  // Consent & subscription
  subscribed          Boolean   @default(true)
  consentAt           DateTime?
  consentSource       String? // "event_registration:<event_id>" or "website_form"
  consentText         String? // Exact checkbox copy they agreed to
  consentVersion      Int       @default(1)
  unsubscribedAt      DateTime?
  // Metadata
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  interests          EventSubscriberInterest[]
  campaignRecipients EventCampaignRecipient[]

  @@index([subscribed])
  @@index([locationLat, locationLng])
  @@index([locationCountryCode])
}

model EventSubscriberInterest {
  subscriberId String
  tagId        String

  subscriber EventSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  tag        EventTag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([subscriberId, tagId])
}

// ============================================================
// EVENT EMAIL CAMPAIGNS
// ============================================================

model EventEmailCampaign {
  id             String              @id @default(dbgenerated("gen_random_uuid()"))
  eventId        String? // null for non-event campaigns
  subject        String
  bodyHtml       String?
  bodyJson       Json? // React Email template data
  audienceQuery  Json? // Stored segmentation filters
  /// Host who sent it (host promo campaigns); null for Udyaibase's own campaigns.
  organizerId    String?
  /// "PLAN" (monthly Pro allowance) or "BOOST" (credit from an Event Boost).
  creditSource   String?
  status         EventCampaignStatus @default(DRAFT)
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientCount Int                 @default(0)
  openCount      Int                 @default(0)
  clickCount     Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  event      Event?                   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  organizer  EventOrganizer?          @relation(fields: [organizerId], references: [id], onDelete: SetNull)
  recipients EventCampaignRecipient[]

  @@index([eventId])
  @@index([status])
  @@index([scheduledAt])
  @@index([organizerId, createdAt])
}

model EventCampaignRecipient {
  id           String    @id @default(dbgenerated("gen_random_uuid()"))
  campaignId   String
  subscriberId String
  sentAt       DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?

  campaign   EventEmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber EventSubscriber    @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([campaignId, subscriberId])
  @@index([campaignId])
  @@index([subscriberId])
}

// ============================================================
// STARTUP BUSINESS CATEGORIES & TYPES (Admin-managed lookup)
// ============================================================

model StartupBusinessCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([sortOrder])
  @@index([isActive])
}

model StartupBusinessType {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([sortOrder])
  @@index([isActive])
}

model ToolAlternative {
  id            String   @id @default(dbgenerated("gen_random_uuid()"))
  toolId        String
  alternativeId String
  source        String   @default("admin")
  createdAt     DateTime @default(now())

  tool        AiTool @relation("ToolToAlternatives", fields: [toolId], references: [id], onDelete: Cascade)
  alternative AiTool @relation("AlternativeToTools", fields: [alternativeId], references: [id], onDelete: Cascade)

  @@unique([toolId, alternativeId])
  @@index([toolId])
  @@index([alternativeId])
}

model ToolReviewResponse {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  reviewId  String   @unique
  founderId String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  review  ToolReview  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  founder FounderUser @relation(fields: [founderId], references: [id], onDelete: Cascade)

  @@index([founderId])
}

model ToolTagGroup {
  id                String   @id @default(dbgenerated("gen_random_uuid()"))
  name              String   @unique
  slug              String   @unique
  icon              String?
  description       String?
  sortOrder         Int      @default(0)
  displayMode       String   @default("expandable") // expandable | searchable | chips
  maxVisibleDefault Int      @default(6)
  isAdminOnly       Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tags ToolSystemTag[]

  @@index([sortOrder])
}

model ToolSystemTag {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  name      String
  slug      String   @unique
  emoji     String?
  groupId   String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  tagCount  Int      @default(0) // denormalized count of tools using this tag
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group    ToolTagGroup           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  mappings ToolSystemTagMapping[]

  @@unique([groupId, slug])
  @@index([groupId, sortOrder])
  @@index([tagCount(sort: Desc)])
}

model ToolSystemTagMapping {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  toolId    String
  tagId     String
  addedBy   String   @default("admin") // admin | founder | system
  createdAt DateTime @default(now())

  tool AiTool        @relation(fields: [toolId], references: [id], onDelete: Cascade)
  tag  ToolSystemTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([toolId, tagId])
  @@index([tagId, toolId])
}

// ============================================================
// AI JOB BOARD — Employer Platform
// Separate from /careers (internal hiring) and old Job model
// ============================================================

enum JobBoardEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum JobBoardWorkType {
  REMOTE
  HYBRID
  ONSITE
}

enum JobBoardCategory {
  AI_ENGINEER
  ML_ENGINEER
  LLM_ENGINEER
  AI_RESEARCH_SCIENTIST
  DATA_SCIENTIST
  DATA_ENGINEER
  PROMPT_ENGINEER
  AI_PRODUCT_MANAGER
  AI_DESIGNER
  AI_SALES
  AI_MARKETING
  AI_DEVREL
  AI_SOLUTIONS_ARCHITECT
  AI_ETHICS
  ROBOTICS_ENGINEER
  COMPUTER_VISION
  NLP_ENGINEER
  AI_INFRASTRUCTURE
  OTHER
}

enum JobBoardTier {
  FREE
  FEATURED
  PREMIUM
}

enum JobBoardApplyType {
  INTERNAL
  EXTERNAL
}

enum JobBoardAppStatus {
  APPLIED
  REVIEWED
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum JobBoardListingStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
}

enum JobBoardCloseReason {
  EXPIRED
  FILLED
  MANUAL
}

enum JobBoardApplicationSource {
  JOBS_PAGE
  STARTUP_PROFILE
  GOOGLE
  CAREERS_PAGE
  WIDGET
  REFERRAL
  DIRECT
  OTHER
}

enum JobBoardClaimMethod {
  DOMAIN_OTP
  ADMIN
  FOUNDER
  LEGACY_UNVERIFIED
}

enum JobBoardEmailStatus {
  QUEUED
  SCHEDULED
  SENT
  FAILED
}

enum JobBoardPlan {
  FREE
  FEATURED
  PREMIUM
}

model JobBoardEmployer {
  id                  String       @id @default(cuid())
  companyName         String
  slug                String       @unique
  email               String       @unique
  passwordHash        String
  logoUrl             String?
  websiteUrl          String?
  description         String?
  industry            String?
  companySize         String?
  location            String?
  country             String?
  linkedinUrl         String?
  twitterUrl          String?
  startupId           String?      @unique
  plan                JobBoardPlan @default(FREE)
  planExpiresAt       DateTime?
  /// Last "plan ends soon" reminder, so the daily cron sends it once per period.
  planReminderSentAt  DateTime?
  /// When on, jobs written by recruiters wait for an owner to publish them.
  requireJobApproval  Boolean      @default(false)
  /// The current plan is the free Featured trial (no grace period after it ends).
  planIsTrial         Boolean      @default(false)
  /// One trial per workspace (and per verified startup / company domain).
  trialStartedAt      DateTime?
  /// "Your plan has ended, renew within 3 days" email, once per lapse.
  planGraceNoticeAt   DateTime?
  /// GST invoice details (optional; B2B buyers add a GSTIN).
  billingName         String?
  billingGstin        String?
  billingAddress      String?
  billingState        String?
  /// Billing profile (invoices): GST | BUSINESS (unregistered) | INDIVIDUAL.
  billingType         String?
  billingAddressLine1 String?
  billingAddressLine2 String?
  billingCity         String?
  billingPostalCode   String?
  billingCountry      String?      @default("IN")
  /// Customer's PO / reference number, printed on invoices.
  billingPoNumber     String?
  /// Where invoices, receipts and credit notes are emailed (plus up to 3 CC).
  billingEmail        String?
  billingCcEmails     String[]     @default([])
  /// Paid plans: screen new applicants with AI automatically while quota remains.
  aiAutoScreen        Boolean      @default(true)
  /// Last "candidates are waiting" nudge email.
  reviewNudgeAt       DateTime?
  maxActiveJobs       Int          @default(1)
  isVerified          Boolean      @default(false)
  isActive            Boolean      @default(true)
  emailVerified       Boolean      @default(false)
  resetToken          String?
  resetTokenExpiry    DateTime?
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // 2FA
  twoFactorEnabled     Boolean  @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String[]

  // Email change
  pendingEmail           String?
  emailChangeToken       String?   @unique
  emailChangeTokenExpiry DateTime?

  // Onboarding
  onboardingCompleted Boolean @default(false)
  onboardingStep      Int     @default(0)

  // Startup claim (ownership proof)
  /// Founder account that owns this hiring workspace (signs in via the founder portal).
  founderUserId          String?
  startupClaimMethod     JobBoardClaimMethod?
  startupClaimVerifiedAt DateTime?
  verifiedCompanyDomain  String?

  // Careers page / profile
  brandColor          String?
  tagline             String?
  stage               String?
  teamSize            String?
  perks               String[]  @default([])
  officePhotos        String[]  @default([])
  techStack           String[]  @default([])
  careersHeadline     String?
  firstJobPublishedAt DateTime?
  /// Calendly / Cal.com / Google Calendar link offered in interview emails.
  interviewBookingUrl String?

  // Account lifecycle
  deactivatedAt DateTime?
  deletedAt     DateTime?

  Listings       JobBoardListing[]
  CareersWidgets JobBoardCareersWidget[]
  TeamMembers    JobBoardTeamMember[]
  Payments       JobBoardPayment[]
  AiScreenings   JobBoardAiScreening[]
  Startup        Startup?                @relation(fields: [startupId], references: [id], onDelete: SetNull)
  FounderUser    FounderUser?            @relation(fields: [founderUserId], references: [id], onDelete: SetNull)

  @@index([founderUserId])
  @@index([startupId])
  @@index([isActive])
  @@index([plan])
  @@index([deactivatedAt])
}

model JobBoardListing {
  id                   String                   @id @default(cuid())
  slug                 String                   @unique
  title                String
  description          String
  shortDescription     String?
  location             String?
  city                 String?
  country              String?
  workType             JobBoardWorkType         @default(REMOTE)
  employmentType       JobBoardEmploymentType   @default(FULL_TIME)
  visaSponsorship      Boolean                  @default(false)
  salaryMin            Int?
  salaryMax            Int?
  salaryCurrency       String                   @default("USD")
  salaryPeriod         String                   @default("yearly")
  showSalary           Boolean                  @default(true)
  equity               String?
  category             JobBoardCategory         @default(AI_ENGINEER)
  experienceMin        Int?
  experienceMax        Int?
  skills               String[]                 @default([])
  department           String?
  listingTier          JobBoardTier             @default(FREE)
  isFeatured           Boolean                  @default(false)
  featuredUntil        DateTime?
  isActive             Boolean                  @default(true)
  expiresAt            DateTime?
  applicationUrl       String?
  applicationEmail     String?
  applicationType      JobBoardApplyType        @default(INTERNAL)
  status               JobBoardListingStatus    @default(OPEN)
  closedAt             DateTime?
  closeReason          JobBoardCloseReason?
  experienceBand       String?
  hasEsops             Boolean                  @default(false)
  screeningQuestions   Json?
  showOnJobsPage       Boolean                  @default(true)
  showOnProfile        Boolean                  @default(true)
  showOnCareers        Boolean                  @default(true)
  hiringManagerName    String?
  draftSavedAt         DateTime?
  /// A recruiter asked an owner to publish this draft (approval mode).
  approvalRequestedAt  DateTime?
  approvalRequestedBy  String?
  /// Subset of `skills` the employer marked as must-have (weighted higher in the match score).
  mustHaveSkills       String[]                 @default([])
  /// "Prefer people who can join within N days"; null = no preference.
  maxNoticeDays        Int?
  /// Hidden from every public surface while reports are reviewed by an admin.
  moderationHold       Boolean                  @default(false)
  moderationHoldAt     DateTime?
  /// Last "still hiring?" email before the closing date.
  expiryNudgeAt        DateTime?
  /// Who first published it (owner or a teammate), for accountability and moderation.
  publishedByEmail     String?
  publishedByName      String?
  /// Premium plan promotion, done by the Udyaibase team (admin promotion queue).
  promotedNewsletterAt DateTime?
  promotedSocialAt     DateTime?
  promotedSocialUrl    String?
  applicationsCount    Int                      @default(0)
  viewsCount           Int                      @default(0)
  clicksCount          Int                      @default(0)
  savedCount           Int                      @default(0)
  employerId           String
  startupId            String?
  searchVector         Unsupported("tsvector")?
  publishedAt          DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  deletedAt            DateTime?

  Employer      JobBoardEmployer       @relation(fields: [employerId], references: [id], onDelete: Cascade)
  Startup       Startup?               @relation(fields: [startupId], references: [id], onDelete: SetNull)
  Applications  JobBoardApplication[]
  TalentInvites JobBoardTalentInvite[]
  SavedBy       JobBoardSaved[]

  siteAnnouncements SiteAnnouncement[]

  @@index([status, expiresAt])
  @@index([isActive, category])
  @@index([isActive, workType])
  @@index([isActive, listingTier])
  @@index([employerId])
  @@index([startupId])
  @@index([publishedAt])
  @@index([expiresAt])
  @@index([searchVector], type: Gin)
  @@index([deletedAt])
}

model JobBoardApplication {
  id               String                    @id @default(cuid())
  listingId        String
  fullName         String
  email            String
  phone            String?
  linkedinUrl      String?
  portfolioUrl     String?
  githubUrl        String?
  resumeUrl        String?
  resumeKey        String?
  coverLetter      String?
  source           JobBoardApplicationSource @default(JOBS_PAGE)
  widgetId         String?
  referrerUrl      String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  experienceYears  Int?
  noticePeriodDays Int?
  currentCompany   String?
  currentTitle     String?
  expectedCtcLakh  Float?
  city             String?
  screeningAnswers Json?
  confirmedSkills  String[]                  @default([])
  matchedSkills    String[]                  @default([])
  consentAt        DateTime?
  consentText      String?
  withdrawnAt      DateTime?
  statusTokenHash  String?
  firstResponseAt  DateTime?
  /// Candidate opted in to be contacted about other roles at this company until this date.
  talentPoolUntil  DateTime?
  status           JobBoardAppStatus         @default(APPLIED)
  notes            String?
  rating           Int?
  appliedAt        DateTime                  @default(now())
  reviewedAt       DateTime?
  statusChangedAt  DateTime?

  Listing       JobBoardListing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  Notes         JobBoardApplicationNote[]
  Events        JobBoardApplicationEvent[]
  ResumeUploads JobBoardResumeUpload[]
  AiScreening   JobBoardAiScreening?
  TalentInvites JobBoardTalentInvite[]

  @@unique([listingId, email])
  @@index([statusTokenHash])
  @@index([listingId, status])
  @@index([email])
  @@index([appliedAt])
  @@index([status])
}

model JobBoardSaved {
  id        String   @id @default(cuid())
  listingId String
  userId    String
  createdAt DateTime @default(now())

  Listing JobBoardListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  WebUser WebUser         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listingId, userId])
  @@index([userId])
  @@index([listingId])
}

model JobBoardResumeUpload {
  id            String   @id @default(cuid())
  key           String   @unique
  sha256        String
  sizeBytes     Int
  mime          String
  listingId     String
  applicationId String?
  ipHash        String
  parseCount    Int      @default(0)
  createdAt     DateTime @default(now())

  Application JobBoardApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
}

model JobBoardApplicationNote {
  id            String   @id @default(cuid())
  applicationId String
  authorEmail   String
  authorName    String
  body          String
  mentions      String[] @default([])
  createdAt     DateTime @default(now())

  Application JobBoardApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model JobBoardApplicationEvent {
  id             String               @id @default(cuid())
  applicationId  String
  fromStatus     JobBoardAppStatus?
  toStatus       JobBoardAppStatus
  actorEmail     String
  emailSubject   String?
  emailBody      String?
  emailStatus    JobBoardEmailStatus?
  resendId       String?
  scheduledFor   DateTime?
  idempotencyKey String?              @unique
  createdAt      DateTime             @default(now())

  Application JobBoardApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([emailStatus])
}

