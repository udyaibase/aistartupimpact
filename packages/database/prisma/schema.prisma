  markedInstalledAt DateTime?
  firstSeenAt       DateTime?
  firstSeenHost     String?
  lastSeenAt        DateTime?
  lastSeenHost      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

