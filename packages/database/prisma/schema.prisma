  buttonSize        String    @default("md") // "sm" | "md" | "lg"
  buttonStyle       String    @default("filled") // "filled" | "outline" | "soft"
  cardStyle         String    @default("bordered") // "bordered" | "elevated" | "flat"
  spacing           String    @default("comfortable") // "compact" | "comfortable" | "spacious"
  showPast          Boolean   @default(false)
  registrationMode  String    @default("inline") // "inline" | "page"
  showPoweredBy     Boolean   @default(true)
  categories        String[]
  eventIds          String[]
  maxEvents         Int       @default(10)
  allowedDomains    String[]
  active            Boolean   @default(true)
  // Setup funnel + install detection
  platform          String?
  setupStartedAt    DateTime?
  codeCopiedAt      DateTime?
  markedInstalledAt DateTime?
  firstSeenAt       DateTime?
  firstSeenHost     String?
  lastSeenAt        DateTime?
  lastSeenHost      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  registrations EventRegistration[]

  organizer EventOrganizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([organizerId])
  @@index([active])
}

// ============================================================
// TEAM MANAGEMENT
// ============================================================

model EventTeamMember {
  id                String           @id @default(dbgenerated("gen_random_uuid()"))
  organizerId       String
  email             String
  role              TeamRole         @default(STAFF)
  status            TeamMemberStatus @default(PENDING)
  inviteToken       String           @unique
  expiresAt         DateTime
  /// The organizer account that accepted the invite; access follows this account, not the email address.
  memberOrganizerId String?
  passwordHash      String?
  acceptedAt        DateTime?
  createdAt         DateTime         @default(now())

  organizer    EventOrganizer        @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  assignments  EventTeamAssignment[]
  activityLogs TeamActivityLog[]

  @@unique([organizerId, email])
  @@index([email])
  @@index([memberOrganizerId])
  @@index([inviteToken])
  @@index([organizerId])
}

model EventTeamAssignment {
  id           String @id @default(dbgenerated("gen_random_uuid()"))
  teamMemberId String
  eventId      String

  teamMember EventTeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  event      Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([teamMemberId, eventId])
  @@index([teamMemberId])
  @@index([eventId])
}

/// Activity log of an employer or event-host workspace: who did what, when and from where. Owners and admins see it
/// in the portal (/employer/activity, /organizer/activity). No foreign keys on purpose: entries outlive deleted
/// members and workspaces. Kept for one year (data-retention job). Never store passwords, codes or tokens.
model WorkspaceActivityLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  /// EMPLOYER (JobBoardEmployer) or ORGANIZER (EventOrganizer).
  workspace   String
  workspaceId String
  /// Who did it: a person's name and masked email; null for the system (e.g. a payment webhook).
  actorName   String?
  actorEmail  String?
  action      String
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([workspace, workspaceId, createdAt])
  @@index([createdAt])
}

model TeamActivityLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  teamMemberId String?
  organizerId  String?
  eventId      String?
  action       String
  targetName   String?
  targetEmail  String?
  metadata     String?
  createdAt    DateTime @default(now())

  teamMember EventTeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)

  @@index([teamMemberId, createdAt])
  @@index([organizerId, createdAt])
  @@index([eventId, createdAt])
}

model FounderTeamMember {
  id           String           @id @default(cuid())
  founderId    String
  email        String
  name         String?
  role         FounderTeamRole  @default(VIEWER)
  status       TeamMemberStatus @default(PENDING)
  inviteToken  String?          @unique
  expiresAt    DateTime?
  passwordHash String?
  acceptedAt   DateTime?
  lastActiveAt DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  founder FounderUser @relation(fields: [founderId], references: [id], onDelete: Cascade)

  @@unique([founderId, email])
  @@index([email])
  @@index([inviteToken])
  @@index([founderId])
}

model FounderMilestone {
  id                 String             @id @default(cuid())
  founderId          String
  startupId          String
  type               MilestoneType
  title              String
  description        String?
  amount             Decimal?
  currency           String?            @default("INR")
  date               DateTime
  source             MilestoneSource    @default(FOUNDER_SUBMITTED)
  verificationStatus VerificationStatus @default(FOUNDER_REPORTED)
  verifiedBy         String?
  verifiedAt         DateTime?
  verificationNote   String?
  isPublic           Boolean            @default(true)
  status             String             @default("ACTIVE")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  founder      FounderUser            @relation(fields: [founderId], references: [id], onDelete: Cascade)
  startup      Startup                @relation(fields: [startupId], references: [id], onDelete: Cascade)
  activityLogs ContentActivityLog[]
  media        ContentMedia[]
  reports      FounderContentReport[]

  @@index([startupId, type])
  @@index([startupId, date])
  @@index([founderId])
  @@index([verificationStatus])
  @@index([status, isPublic])
}

model ContentActivityLog {
  id          String        @id @default(cuid())
  contentId   String?
  milestoneId String?
  startupId   String
  actorId     String
  actorType   String        @default("FOUNDER")
  action      ContentAction
  metadata    Json?
  createdAt   DateTime      @default(now())

  article   Article?          @relation(fields: [contentId], references: [id], onDelete: SetNull)
  milestone FounderMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  startup   Startup           @relation(fields: [startupId], references: [id], onDelete: Cascade)
  actor     FounderUser       @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([contentId, createdAt])
  @@index([milestoneId, createdAt])
  @@index([startupId, createdAt])
  @@index([actorId, createdAt])
}

model ContentMedia {
  id           String   @id @default(cuid())
  contentId    String?
  milestoneId  String?
  startupId    String
  uploadedBy   String
  type         String   @default("IMAGE")
  url          String
  thumbnailUrl String?
  fileName     String
  fileSize     Int      @default(0)
  mimeType     String
  alt          String?
  caption      String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  article   Article?          @relation(fields: [contentId], references: [id], onDelete: SetNull)
  milestone FounderMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  startup   Startup           @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([milestoneId])
  @@index([startupId])
}

model FounderContentReport {
  id           String       @id @default(cuid())
  contentId    String?
  milestoneId  String?
  reporterType String       @default("ANONYMOUS")
  reporterId   String?
  reason       ReportReason
  description  String?
  status       ReportStatus @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())

  article   Article?          @relation(fields: [contentId], references: [id], onDelete: SetNull)
  milestone FounderMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([contentId])
  @@index([milestoneId])
  @@index([status])
}

// ============================================================
// EVENT PLATFORM MODELS
// ============================================================

enum EventCategory {
  CONFERENCE
  HACKATHON
  SUMMIT
  WORKSHOP
  MEETUP
  DEMO_DAY
  WEBINAR
  NETWORKING
}

enum EventFormat {
  IN_PERSON
  VIRTUAL
  HYBRID
}

/// PENDING_REVIEW: not public. A new independent organizer's first event waits for admin approval, and an event
/// hidden after repeated reports (ContentReport, entityType EVENT) waits for review. Only admins move it on.
enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  POSTPONED
  COMPLETED
  ARCHIVED
  PENDING_REVIEW
}

enum EventVisibility {
  PUBLIC
  UNLISTED
  INVITE_ONLY
}

enum RegistrationStatus {
  CONFIRMED
  PENDING_APPROVAL
  PENDING_PAYMENT
  WAITLISTED
  CANCELLED
  CHECKED_IN
}

enum TicketTierType {
  EARLY_BIRD
  REGULAR
  VIP
}

enum EventCustomQuestionType {
  TEXT
  SELECT
  CHECKBOX
}

enum EventCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

model Event {
  id                          String          @id @default(dbgenerated("gen_random_uuid()"))
  slug                        String          @unique
  shortCode                   String          @unique // Immutable 6-char code for short URLs (/e/KX7M4P)
  organizerId                 String
  title                       String
  subtitle                    String?
  category                    EventCategory
  format                      EventFormat
  status                      EventStatus     @default(DRAFT)
  /// Hosted by this startup ("Hosted by NeuralPay"): only a verified startup, tagged by one of its own people.
  startupId                   String?
  /// Admin review: when it was approved (or declined), why it waits, and when reports hid it.
  reviewedAt                  DateTime?
  reviewNote                  String?
  heldAt                      DateTime?
  // Date & Time
  startAt                     DateTime
  endAt                       DateTime
  timezone                    String          @default("Asia/Kolkata")
  // Location (in-person/hybrid)
  venueName                   String?
  address                     String?
  /// Map link for the venue (Google Maps etc.), sent to registered attendees with the address.
  venueMapUrl                 String?
  latitude                    Float?
  longitude                   Float?
  // Virtual (virtual/hybrid)
  meetingLink                 String?
  revealLinkAfterRegistration Boolean         @default(false)
  // Content
  coverImageUrl               String?
  galleryImageUrls            String[]        @default([])
  description                 Json? // Rich text (Tiptap JSON)
  // Capacity & Registration
  capacity                    Int?
  /// Featured on Udyaibase Events until this time (Event Boost or Pro plan).
  featuredUntil               DateTime?
  /// One-time Event Boost purchased: higher registration limit for this event.
  boostedAt                   DateTime?
  /// First time registrations hit the host plan limit; the host is emailed once. Cleared when the limit rises.
  planLimitNotifiedAt         DateTime?
  /// Promo emails left that came with an Event Boost.
  promoCredits                Int             @default(0)
  registrationCount           Int             @default(0)
  visibility                  EventVisibility @default(PUBLIC)
  registrationDeadline        DateTime?
  approvalRequired            Boolean         @default(false)
  // SEO & Sharing
  metaTitle                   String?
  metaDescription             String?
  socialImageUrl              String?
  // External / scraped event
  sourceUrl                   String? // Original URL for scraped events; null = native Udyaibase event
  sourceName                  String? // e.g. "Luma", "Eventbrite", "Meetup"
  // Publishing
  publishAt                   DateTime? // Scheduled publish
  publishedAt                 DateTime?
  // Soft delete
  deletedAt                   DateTime?
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt

  // Relations
  organizer       EventOrganizer        @relation(fields: [organizerId], references: [id])
  Startup         Startup?              @relation(fields: [startupId], references: [id], onDelete: SetNull)
  speakers        EventSpeaker[]
  agendaItems     EventAgendaItem[]
  ticketTiers     EventTicketTier[]
  customQuestions EventCustomQuestion[]
  registrations   EventRegistration[]
  tags            EventTagMapping[]
  campaigns       EventEmailCampaign[]
  slugHistory     EventSlugHistory[]
  teamAssignments EventTeamAssignment[]

  // After the event
  /// Certificate design and rules: { template, audience, signerName, signerTitle, signatureUrl, autoIssue }.
  certificateSettings Json?
  /// Certificates bought for this one event (Free hosts; Pro hosts have them included).
  certificatesPaidAt  DateTime?
  /// Follow-up emails: { auto, attendedSubject, attendedBody, missedSubject, missedBody, includeMissed }.
  followUpSettings    Json?
  /// When the automatic follow-up went out (so it's sent once).
  followUpAutoSentAt  DateTime?
  /// Feedback survey: { enabled, questions: string[] (up to 3 short-answer questions) }.
  feedbackSettings    Json?
  /// Recap shown on the event page after it ends: a few lines of highlights.
  recapSummary        String?
  /// Recap links: [{ kind: "recording" | "slides" | "other", title, url }], up to 10.
  recapLinks          Json?
  /// The day-after summary email to the host went out.
  summarySentAt       DateTime?
  /// Agenda tracks in display order, e.g. ["Main stage", "Workshop room"]. Empty = one track.
  agendaTracks        String[]              @default([])
  /// Call for speakers: { open, closesAt, intro, formats: string[] }.
  cfpSettings         Json?
  /// Part of a series ("Bengaluru AI Meetup #42").
  seriesId            String?
  series              EventSeries?          @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  /// When followers of the series were emailed about this event (once).
  seriesAnnouncedAt   DateTime?
  /// Meeting made through a connected Zoom or Google account ("zoom" | "google"), so it can follow time changes.
  meetingProvider     String?
  meetingExternalId   String?
  sponsors            EventSponsor[]
  talkSubmissions     EventTalkSubmission[]
  feedback            EventFeedback[]
  certificates        EventCertificate[]
  siteAnnouncements   SiteAnnouncement[]
  savedBy             SavedEvent[]

  @@index([status, visibility])
  @@index([startAt])
  @@index([organizerId])
  @@index([startupId])
  @@index([category])
  @@index([format])
  @@index([latitude, longitude])
  @@index([deletedAt])
}

model EventSlugHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  eventId   String
  oldSlug   String   @unique // Prevents reuse of old slugs by other events
  newSlug   String
  changedBy String // Organizer ID who made the change
  changedAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventSpeaker {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  eventId      String
  name         String
  title        String?
  company      String?
  headshotUrl  String?
  bio          String?
  talkTitle    String?
  /// Private: for the speaker's portal link and emails (never shown publicly).
  email        String?
  /// Talk submission this speaker came from (call for speakers), if any.
  submissionId String?
  slidesUrl    String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  agendaItems EventAgendaItem[]

  @@index([eventId])
}

model EventAgendaItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  eventId      String
  speakerId    String?
  dayNumber    Int      @default(1)
  startTime    String // "09:00" format for flexible time display
  endTime      String // "10:00"
  title        String
  description  String?
  /// Track name (one of the event's agendaTracks); null = all tracks / single track.
  track        String?
  /// After the event: replay (YouTube, Vimeo, Drive) and slides for this session.
  recordingUrl String?
  slidesUrl    String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event   Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speaker EventSpeaker? @relation(fields: [speakerId], references: [id], onDelete: SetNull)

  @@index([eventId, dayNumber])
}

model EventTicketTier {
  id          String         @id @default(dbgenerated("gen_random_uuid()"))
  eventId     String
  name        String
  priceCents  Int            @default(0) // 0 = free
  quantity    Int? // null = unlimited
  soldCount   Int            @default(0)
  saleStart   DateTime?
  saleEnd     DateTime?
  tierType    TicketTierType @default(REGULAR)
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]

  @@index([eventId])
}

model EventCustomQuestion {
  id           String                  @id @default(dbgenerated("gen_random_uuid()"))
  eventId      String
  questionText String
  questionType EventCustomQuestionType @default(TEXT)
  options      Json? // For SELECT type: ["Option A", "Option B"]
  required     Boolean                 @default(false)
  sortOrder    Int                     @default(0)
  createdAt    DateTime                @default(now())
  /// Removed by the host after people answered it: kept (with the answers) for exports, no longer asked.
  hiddenAt     DateTime?

  event   Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers EventRegistrationAnswer[]

  @@index([eventId])
}

model EventRegistration {
  id                    String             @id @default(dbgenerated("gen_random_uuid()"))
  eventId               String
  userId                String? // nullable for guest registrations
  ticketTierId          String?
  // Guest info (for non-logged-in registrants)
  guestName             String?
  guestEmail            String?
  guestPhone            String?
  guestCompany          String?
  guestRole             String?
  guestOccupation       String?
  // Consent flags
  whatsappConsent       Boolean            @default(false)
  registrationSource    String             @default("WEBSITE") // WEBSITE | EMBED | EVENT_QR | WALK_IN
  // Embed attribution
  referrerUrl           String?
  embedWidgetId         String?
  utmSource             String?
  utmMedium             String?
  utmCampaign           String?
  // Status & tokens
  status                RegistrationStatus @default(CONFIRMED)
  qrToken               String             @unique // 16-char base62
  // Payment (paid tickets via Razorpay Route)
  stripePaymentIntentId String?
  razorpayOrderId       String?
  razorpayPaymentId     String?
  /// PENDING | PAID | FAILED | EXPIRED | REFUNDED
  paymentStatus         String?
  amountPaise           Int?
  /// Udyaibase's share; the rest is transferred to the host's linked account.
  platformFeePaise      Int?
  /// Unpaid seat hold ends here.
  paymentExpiresAt      DateTime?
  /// Why this person was waitlisted: "plan_limit" (host plan cap) or "capacity" (host-set capacity).
  /// On a CANCELLED row, "not_me" means the address's owner said they never registered (see registration-trust.ts).
  waitlistReason        String?
  paidAt                DateTime?
  refundId              String?
  refundedAt            DateTime?
  // Timestamps
  registeredAt          DateTime           @default(now())
  checkedInAt           DateTime?
  cancelledAt           DateTime?
  deletedAt             DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  /// Asked not to get further emails from this host about this event (follow-ups, surveys).
  hostEmailsOptOutAt DateTime?
  // Relations
  event              Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTier         EventTicketTier?          @relation(fields: [ticketTierId], references: [id], onDelete: SetNull)
  embedWidget        EmbedWidget?              @relation(fields: [embedWidgetId], references: [id], onDelete: SetNull)
  answers            EventRegistrationAnswer[]
  certificate        EventCertificate?
  feedback           EventFeedback?

  @@unique([eventId, guestEmail]) // Prevent duplicate registrations by email per event
  @@index([eventId])
  @@index([embedWidgetId])
  @@index([userId])
  @@index([qrToken])
  @@index([status])
  @@index([deletedAt])
  @@index([razorpayOrderId])
}

/// A certificate of attendance/participation. The code is random and unguessable; the public verify page shows
/// only the name, event and date.
model EventCertificate {
  id             String    @id @default(cuid())
  code           String    @unique
  eventId        String
  registrationId String    @unique
  /// Name printed on the certificate, frozen at issue time.
  recipientName  String
  issuedAt       DateTime  @default(now())
  revokedAt      DateTime?

  event        Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

/// One attendee's feedback on an event, from the signed link in the follow-up email (no sign-in needed).
model EventFeedback {
  id             String   @id @default(cuid())
  eventId        String
  registrationId String   @unique
  /// 1-5
  rating         Int
  /// 0-10 "how likely are you to recommend"
  recommend      Int?
  /// Answers to the host's short questions, in order: [{ question, answer }]
  answers        Json?
  comment        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event        Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

/// A talk proposed through an event's call for speakers.
model EventTalkSubmission {
  id          String    @id @default(cuid())
  eventId     String
  name        String
  email       String
  company     String?
  jobTitle    String?
  bio         String?
  headshotUrl String?
  linkedinUrl String?
  title       String
  abstract    String
  /// "Talk", "Workshop", "Panel", "Lightning talk"...
  format      String?
  track       String?
  /// SUBMITTED | ACCEPTED | WAITLISTED | REJECTED
  status      String    @default("SUBMITTED")
  /// Reviewer rating 1-5 and private notes (never shown to the speaker).
  rating      Int?
  notes       String?
  reviewedAt  DateTime?
  /// Speaker created when accepted.
  speakerId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email, title])
  @@index([eventId, status])
}

/// A sponsor shown on an event's page and recap (Pro).
model EventSponsor {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  /// GOLD | SILVER | BRONZE | PARTNER
  tier        String   @default("PARTNER")
  logoUrl     String?
  websiteUrl  String?
  /// Linked startup from the Udyaibase directory, if any.
  startupId   String?
  sortOrder   Int      @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

/// A run of related events ("Bengaluru AI Meetup #41, #42..."), each still its own event.
model EventSeries {
  id               String    @id @default(cuid())
  organizerId      String
  slug             String    @unique
  name             String
  description      String?
  coverImageUrl    String?
  /// Repeat rule: { freq: "WEEKLY" | "MONTHLY", interval, weekday?, monthWeek?, createAheadDays, templateEventId }.
  recurrence       Json?
  /// Last date a repeat was created for (so each date is created once).
  lastGeneratedFor DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organizer EventOrganizer        @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  events    Event[]
  followers EventSeriesFollower[]

  @@index([organizerId])
}

/// Someone who wants an email when the next event in a series opens. Double opt-in.
model EventSeriesFollower {
  id             String    @id @default(cuid())
  seriesId       String
  email          String
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())

  series EventSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, email])
  @@index([seriesId])
}

model EventRegistrationAnswer {
  id             String @id @default(dbgenerated("gen_random_uuid()"))
  registrationId String
  questionId     String
  answerText     String

  registration EventRegistration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  question     EventCustomQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([questionId])
}

// ============================================================
// EVENT NEWSLETTER & GEO-TARGETING
// ============================================================

model EventTag {
  id            String   @id @default(dbgenerated("gen_random_uuid()"))
  name          String   @unique // Display name: "LLM"
  canonicalName String // Normalized: "large-language-models"
  category      String? // "technology", "domain", "format"
  createdAt     DateTime @default(now())

  eventMappings       EventTagMapping[]
  subscriberInterests EventSubscriberInterest[]

  @@index([canonicalName])
  @@index([category])
}

model EventTagMapping {
  eventId String
  tagId   String

  event Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tag   EventTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([eventId, tagId])
}

model EventSubscriber {
  id                  String    @id @default(dbgenerated("gen_random_uuid()"))
  email               String    @unique
  name                String?
  // Location for geo-targeting
  locationCity        String? // "Hyderabad, India"
  locationLat         Float?
  locationLng         Float?
  locationCountryCode String? // "IN"
  locationRegion      String? // "Telangana"
  // Consent & subscription
  subscribed          Boolean   @default(true)
  consentAt           DateTime?
  consentSource       String? // "event_registration:<event_id>" or "website_form"
  consentText         String? // Exact checkbox copy they agreed to
  consentVersion      Int       @default(1)
  unsubscribedAt      DateTime?
  // Metadata
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  interests          EventSubscriberInterest[]
  campaignRecipients EventCampaignRecipient[]

  @@index([subscribed])
  @@index([locationLat, locationLng])
  @@index([locationCountryCode])
}

model EventSubscriberInterest {
  subscriberId String
  tagId        String

  subscriber EventSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  tag        EventTag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([subscriberId, tagId])
}

// ============================================================
// EVENT EMAIL CAMPAIGNS
// ============================================================

model EventEmailCampaign {
  id             String              @id @default(dbgenerated("gen_random_uuid()"))
  eventId        String? // null for non-event campaigns
  /// null for promotions; "FOLLOW_UP" for after-event emails to the event's own registrants.
  kind           String?
  subject        String
  bodyHtml       String?
  bodyJson       Json? // React Email template data
  audienceQuery  Json? // Stored segmentation filters
  /// Host who sent it (host promo campaigns); null for Udyaibase's own campaigns.
  organizerId    String?
  /// "PLAN" (monthly Pro allowance) or "BOOST" (credit from an Event Boost).
  creditSource   String?
  status         EventCampaignStatus @default(DRAFT)
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientCount Int                 @default(0)
  openCount      Int                 @default(0)
  clickCount     Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  event      Event?                   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  organizer  EventOrganizer?          @relation(fields: [organizerId], references: [id], onDelete: SetNull)
  recipients EventCampaignRecipient[]

  @@index([eventId])
  @@index([status])
  @@index([scheduledAt])
  @@index([organizerId, createdAt])
}

model EventCampaignRecipient {
  id           String    @id @default(dbgenerated("gen_random_uuid()"))
  campaignId   String
  subscriberId String
  sentAt       DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?

  campaign   EventEmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber EventSubscriber    @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([campaignId, subscriberId])
  @@index([campaignId])
  @@index([subscriberId])
}

// ============================================================
// STARTUP BUSINESS CATEGORIES & TYPES (Admin-managed lookup)
// ============================================================

model StartupBusinessCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([sortOrder])
  @@index([isActive])
}

model StartupBusinessType {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([sortOrder])
  @@index([isActive])
}

model ToolAlternative {
  id            String   @id @default(dbgenerated("gen_random_uuid()"))
  toolId        String
  alternativeId String
  source        String   @default("admin")
  createdAt     DateTime @default(now())

  tool        AiTool @relation("ToolToAlternatives", fields: [toolId], references: [id], onDelete: Cascade)
  alternative AiTool @relation("AlternativeToTools", fields: [alternativeId], references: [id], onDelete: Cascade)

  @@unique([toolId, alternativeId])
  @@index([toolId])
  @@index([alternativeId])
}

model ToolReviewResponse {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  reviewId  String   @unique
  founderId String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  review  ToolReview  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  founder FounderUser @relation(fields: [founderId], references: [id], onDelete: Cascade)

  @@index([founderId])
}

model ToolTagGroup {
  id                String   @id @default(dbgenerated("gen_random_uuid()"))
  name              String   @unique
  slug              String   @unique
  icon              String?
  description       String?
  sortOrder         Int      @default(0)
  displayMode       String   @default("expandable") // expandable | searchable | chips
  maxVisibleDefault Int      @default(6)
  isAdminOnly       Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tags ToolSystemTag[]

  @@index([sortOrder])
}

model ToolSystemTag {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  name      String
  slug      String   @unique
  emoji     String?
  groupId   String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  tagCount  Int      @default(0) // denormalized count of tools using this tag
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group    ToolTagGroup           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  mappings ToolSystemTagMapping[]

  @@unique([groupId, slug])
  @@index([groupId, sortOrder])
  @@index([tagCount(sort: Desc)])
}

model ToolSystemTagMapping {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  toolId    String
  tagId     String
  addedBy   String   @default("admin") // admin | founder | system
  createdAt DateTime @default(now())

  tool AiTool        @relation(fields: [toolId], references: [id], onDelete: Cascade)
  tag  ToolSystemTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([toolId, tagId])
  @@index([tagId, toolId])
}

// ============================================================
// AI JOB BOARD — Employer Platform
// Separate from /careers (internal hiring) and old Job model
// ============================================================

enum JobBoardEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum JobBoardWorkType {
  REMOTE
  HYBRID
  ONSITE
}

enum JobBoardCategory {
  AI_ENGINEER
  ML_ENGINEER
  LLM_ENGINEER
  AI_RESEARCH_SCIENTIST
  DATA_SCIENTIST
  DATA_ENGINEER
  PROMPT_ENGINEER
  AI_PRODUCT_MANAGER
  AI_DESIGNER
  AI_SALES
  AI_MARKETING
  AI_DEVREL
  AI_SOLUTIONS_ARCHITECT
  AI_ETHICS
  ROBOTICS_ENGINEER
  COMPUTER_VISION
  NLP_ENGINEER
  AI_INFRASTRUCTURE
  // Engineering
  SOFTWARE_ENGINEER
  FRONTEND_ENGINEER
  BACKEND_ENGINEER
  FULL_STACK_ENGINEER
  MOBILE_ENGINEER
  DEVOPS_ENGINEER
  QA_ENGINEER
  SECURITY_ENGINEER
  ENGINEERING_MANAGER
  // Data
  DATA_ANALYST
  BUSINESS_ANALYST
  // Product
  PROJECT_MANAGER
  // Business and operations
  BUSINESS_DEVELOPMENT
  CUSTOMER_SUCCESS
  CUSTOMER_SUPPORT
  OPERATIONS
  FINANCE
  HR_RECRUITING
  CONTENT_WRITING
  LEGAL
  FOUNDERS_OFFICE
  OTHER
}

enum JobBoardTier {
  FREE
  FEATURED
  PREMIUM
}

enum JobBoardApplyType {
  INTERNAL
  EXTERNAL
}

enum JobBoardAppStatus {
  APPLIED
  REVIEWED
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  /// Optional per job: a test or take-home between screening and interviews.
  ASSESSMENT
  /// After the last interview: the decision owner records proceed to offer, reject or keep as backup.
  DECISION
  /// Parked with a come-back date (onHoldUntil) instead of rejected. Counts as active for data retention.
  ON_HOLD
}

enum JobBoardListingStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
}

enum JobBoardCloseReason {
  EXPIRED
  FILLED
  MANUAL
}

enum JobBoardApplicationSource {
  JOBS_PAGE
  STARTUP_PROFILE
  GOOGLE
  CAREERS_PAGE
  WIDGET
  REFERRAL
  DIRECT
  OTHER
  /// Brought over from another tool or a spreadsheet (no emails were sent to them).
  IMPORTED
  /// Found by the team (resume, LinkedIn, referral, event) and added by hand; they didn't apply.
  SOURCED
}

/// How a workspace proved it runs a startup: a work-email code, a DNS TXT record, an admin, or the founder portal.
enum JobBoardClaimMethod {
  DOMAIN_OTP
  ADMIN
  FOUNDER
  LEGACY_UNVERIFIED
  DNS_TXT
}

enum JobBoardEmailStatus {
  QUEUED
  SCHEDULED
  SENT
  FAILED
}

/// FEATURED and PREMIUM are the pre-Nov 2026 names (read as PRO and SCALE); new purchases use the others.
enum JobBoardPlan {
  FREE
  FEATURED
  PREMIUM
  GROWTH
  PRO
  SCALE
}

/// Billing cycle for employer plans and event host Pro.
enum JobBoardBillingCycle {
  MONTHLY
  ANNUAL
}

model JobBoardEmployer {
  id                       String               @id @default(cuid())
  companyName              String
  slug                     String               @unique
  email                    String               @unique
  passwordHash             String
  logoUrl                  String?
  websiteUrl               String?
  description              String?
  industry                 String?
  companySize              String?
  location                 String?
  country                  String?
  linkedinUrl              String?
  twitterUrl               String?
  startupId                String?              @unique
  plan                     JobBoardPlan         @default(FREE)
  planExpiresAt            DateTime?
  /// Last "plan ends soon" reminder, so the daily cron sends it once per period.
  planReminderSentAt       DateTime?
  /// When on, jobs written by recruiters wait for an owner to publish them.
  requireJobApproval       Boolean              @default(false)
  /// The current plan is the free Featured trial (no grace period after it ends).
  planIsTrial              Boolean              @default(false)
  /// One trial per workspace (and per verified startup / company domain).
  trialStartedAt           DateTime?
  /// "Your plan has ended, renew within 3 days" email, once per lapse.
  planGraceNoticeAt        DateTime?
  /// Billing cycle of the current paid plan.
  planCycle                JobBoardBillingCycle @default(MONTHLY)
  /// First annual purchase at the founding price (first 50 workspaces); the price holds for 24 months.
  foundingMemberAt         DateTime?
  /// Set when the plan lapsed to Free after becoming a founding member: the founding price no longer applies.
  foundingLostAt           DateTime?
  /// GST invoice details (optional; B2B buyers add a GSTIN).
  billingName              String?
  billingGstin             String?
  billingAddress           String?
  billingState             String?
  /// Billing profile (invoices): GST | BUSINESS (unregistered) | INDIVIDUAL.
  billingType              String?
  billingAddressLine1      String?
  billingAddressLine2      String?
  billingCity              String?
  billingPostalCode        String?
  billingCountry           String?              @default("IN")
  /// Customer's PO / reference number, printed on invoices.
  billingPoNumber          String?
  /// Where invoices, receipts and credit notes are emailed (plus up to 3 CC).
  billingEmail             String?
  billingCcEmails          String[]             @default([])
  /// Screen new applicants with AI automatically while the plan's quota remains.
  aiAutoScreen             Boolean              @default(true)
  /// Last "candidates are waiting" nudge email.
  reviewNudgeAt            DateTime?
  /// The workspace account's own Monday hiring report (teammates have their own switch).
  weeklyReport             Boolean              @default(true)
  /// Last Monday report run for this workspace, so a retried job never sends twice in a week.
  weeklyReportSentAt       DateTime?
  /// Company check for a workspace whose startup isn't founder-verified: PENDING | APPROVED | REJECTED.
  /// APPROVED allows up to 2 live jobs, labelled "Email verified" (never the verified tick).
  companyReview            String?
  companyReviewRequestedAt DateTime?
  companyReviewRequestedBy String?
  companyReviewedAt        DateTime?
  companyReviewedBy        String?
  /// Shown to the team when the check fails.
  companyReviewNote        String?
  /// MCA company number (CIN or LLPIN), optional, helps the check.
  companyCin               String?
  /// "Send to your founder": who was asked, when, and when the one reminder went.
  founderAskEmail          String?
  founderAskedAt           DateTime?
  founderAskRemindedAt     DateTime?
  /// Sourcing: let AI read resumes the team uploads to fill the form (the company must have a reason to hold the data).
  aiReadSourcedResumes     Boolean              @default(true)
  maxActiveJobs            Int                  @default(1)
  isVerified               Boolean              @default(false)
  isActive                 Boolean              @default(true)
  emailVerified            Boolean              @default(false)
  resetToken               String?
  resetTokenExpiry         DateTime?
  failedLoginAttempts      Int                  @default(0)
  lockedUntil              DateTime?
  lastLoginAt              DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  // 2FA
  twoFactorEnabled     Boolean  @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String[]

  // Email change
  pendingEmail           String?
  emailChangeToken       String?   @unique
  emailChangeTokenExpiry DateTime?

  // Onboarding
  onboardingCompleted Boolean @default(false)
  onboardingStep      Int     @default(0)

  // Startup claim (ownership proof)
  /// Founder account that owns this hiring workspace (signs in via the founder portal).
  founderUserId          String?
  startupClaimMethod     JobBoardClaimMethod?
  startupClaimVerifiedAt DateTime?
  verifiedCompanyDomain  String?

  // Careers page / profile
  brandColor                String?
  tagline                   String?
  stage                     String?
  teamSize                  String?
  perks                     String[]  @default([])
  officePhotos              String[]  @default([])
  techStack                 String[]  @default([])
  careersHeadline           String?
  firstJobPublishedAt       DateTime?
  /// Calendly / Cal.com / Google Calendar link offered in interview emails.
  interviewBookingUrl       String?
  /// Which application fields are shown and required, plus the form's wording (lib/jobs/apply-form.ts). Null = defaults.
  applyFormConfig           Json?
  /// "Life at {company}" sections in order (lib/jobs/careers-content.ts). Null = none yet.
  careersContent            Json?
  /// Show "Apply generally" on the careers page and widget when no roles are open.
  acceptGeneralApplications Boolean   @default(false)

  // Sessions issued before this moment are no longer valid (set when a password changes)
  sessionsValidAfter DateTime?

  // Account lifecycle
  deactivatedAt DateTime?
  deletedAt     DateTime?

  Listings           JobBoardListing[]
  CareersWidgets     JobBoardCareersWidget[]
  CareersSubscribers JobBoardCareersSubscriber[]
  TeamMembers        JobBoardTeamMember[]
  Payments           JobBoardPayment[]
  AiScreenings       JobBoardAiScreening[]
  Referrers          JobBoardReferrer[]
  ShortlistShares    JobBoardShortlistShare[]
  OnboardingSteps    JobBoardOnboardingStep[]
  PipelineTemplates  JobBoardPipelineTemplate[]
  Imports            JobBoardImport[]
  Startup            Startup?                    @relation(fields: [startupId], references: [id], onDelete: SetNull)
  FounderUser        FounderUser?                @relation(fields: [founderUserId], references: [id], onDelete: SetNull)

  @@index([founderUserId])
  @@index([startupId])
  @@index([isActive])
  @@index([plan])
  @@index([deactivatedAt])
}

model JobBoardListing {
  id                    String                   @id @default(cuid())
  slug                  String                   @unique
  title                 String
  description           String
  shortDescription      String?
  location              String?
  city                  String?
  country               String?
  workType              JobBoardWorkType         @default(REMOTE)
  employmentType        JobBoardEmploymentType   @default(FULL_TIME)
  visaSponsorship       Boolean                  @default(false)
  salaryMin             Int?
  salaryMax             Int?
  salaryCurrency        String                   @default("USD")
  salaryPeriod          String                   @default("yearly")
  showSalary            Boolean                  @default(true)
  equity                String?
  category              JobBoardCategory         @default(AI_ENGINEER)
  /// The employer's own category name when none of the standard ones fit (category is then OTHER).
  categoryLabel         String?
  experienceMin         Int?
  experienceMax         Int?
  skills                String[]                 @default([])
  department            String?
  listingTier           JobBoardTier             @default(FREE)
  isFeatured            Boolean                  @default(false)
  featuredUntil         DateTime?
  isActive              Boolean                  @default(true)
  expiresAt             DateTime?
  applicationUrl        String?
  applicationEmail      String?
  applicationType       JobBoardApplyType        @default(INTERNAL)
  status                JobBoardListingStatus    @default(OPEN)
  closedAt              DateTime?
  closeReason           JobBoardCloseReason?
  experienceBand        String?
  hasEsops              Boolean                  @default(false)
  screeningQuestions    Json?
  showOnJobsPage        Boolean                  @default(true)
  showOnProfile         Boolean                  @default(true)
  showOnCareers         Boolean                  @default(true)
  /// The workspace's hidden "General application" listing: never public, collects applications when no roles are open.
  isGeneral             Boolean                  @default(false)
  hiringManagerName     String?
  draftSavedAt          DateTime?
  /// A recruiter asked an owner to publish this draft (approval mode).
  approvalRequestedAt   DateTime?
  approvalRequestedBy   String?
  /// Subset of `skills` the employer marked as must-have (weighted higher in the match score).
  mustHaveSkills        String[]                 @default([])
  /// "Prefer people who can join within N days"; null = no preference.
  maxNoticeDays         Int?
  /// How many people this role is hiring ("openings"). Never limits applications; tracked against hires.
  positions             Int                      @default(1)
  /// Named interview rounds in order, e.g. [\"Screening call\", \"Technical\", \"Final\"]. Empty = one \"Interview\" round.
  interviewRounds       String[]                 @default([])
  /// Someone pressed Publish but the company isn't cleared yet; it goes live by itself once the founder verifies
  /// or the admin check passes.
  publishWaitingAt      DateTime?
  /// Who pressed Publish (credited as the publisher when it goes live).
  publishWaitingBy      String?
  /// Pipeline template the job was set up from (FOUNDER_LED, WITH_ASSESSMENT, or a saved template id) and its version.
  pipelineTemplate      String                   @default("FOUNDER_LED")
  pipelineVersion       Int                      @default(1)
  /// Assessment setup when the job uses one (null = off): { kind, brief, url, deadlineDays, passMark, maxScore }.
  assessment            Json?
  /// Who records the final decision (default: the job's owners) and their delegate.
  decisionOwnerEmail    String?
  decisionDelegateEmail String?
  /// Whether recruiters can see offer amounts (owners and the decision owner always can).
  recruitersSeeOffers   Boolean                  @default(false)
  /// Hidden from every public surface while reports are reviewed by an admin.
  moderationHold        Boolean                  @default(false)
  moderationHoldAt      DateTime?
  /// Last "still hiring?" email before the closing date.
  expiryNudgeAt         DateTime?
  /// Who first published it (owner or a teammate), for accountability and moderation.
  publishedByEmail      String?
  publishedByName       String?
  /// Premium plan promotion, done by the Udyaibase team (admin promotion queue).
  promotedNewsletterAt  DateTime?
  promotedSocialAt      DateTime?
  promotedSocialUrl     String?
  applicationsCount     Int                      @default(0)
  viewsCount            Int                      @default(0)
  clicksCount           Int                      @default(0)
  savedCount            Int                      @default(0)
  employerId            String
  startupId             String?
  searchVector          Unsupported("tsvector")?
  publishedAt           DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  deletedAt             DateTime?

  Employer      JobBoardEmployer       @relation(fields: [employerId], references: [id], onDelete: Cascade)
  Startup       Startup?               @relation(fields: [startupId], references: [id], onDelete: SetNull)
  Applications  JobBoardApplication[]
  TalentInvites JobBoardTalentInvite[]
  SavedBy       JobBoardSaved[]

  siteAnnouncements SiteAnnouncement[]

  @@index([status, expiresAt])
  @@index([isActive, category])
  @@index([isActive, workType])
  @@index([isActive, listingTier])
  @@index([employerId])
  @@index([startupId])
  @@index([publishedAt])
  @@index([expiresAt])
  @@index([searchVector], type: Gin)
  @@index([deletedAt])
}

model JobBoardApplication {
  id                   String                    @id @default(cuid())
  listingId            String
  fullName             String
  email                String
  phone                String?
  linkedinUrl          String?
  portfolioUrl         String?
  githubUrl            String?
  resumeUrl            String?
  resumeKey            String?
  coverLetter          String?
  source               JobBoardApplicationSource @default(JOBS_PAGE)
  widgetId             String?
  referrerUrl          String?
  utmSource            String?
  utmMedium            String?
  utmCampaign          String?
  experienceYears      Int?
  noticePeriodDays     Int?
  currentCompany       String?
  currentTitle         String?
  expectedCtcLakh      Float?
  city                 String?
  screeningAnswers     Json?
  confirmedSkills      String[]                  @default([])
  matchedSkills        String[]                  @default([])
  consentAt            DateTime?
  consentText          String?
  withdrawnAt          DateTime?
  statusTokenHash      String?
  firstResponseAt      DateTime?
  /// Candidate opted in to be contacted about other roles at this company until this date.
  talentPoolUntil      DateTime?
  /// Private team tags in the talent pool (e.g. "backend", "next quarter"). Never shown to the candidate.
  talentTags           String[]                  @default([])
  /// When the "your talent pool membership ends in 30 days" email was sent for the current period.
  talentPoolReminderAt DateTime?
  status               JobBoardAppStatus         @default(APPLIED)
  /// Why they left the pipeline (lib/employer/exit-reasons.ts). Internal: never shown to the candidate.
  exitReason           String?
  /// Required when exitReason is OTHER. Internal.
  exitNote             String?
  /// On hold: the date to look at this candidate again.
  onHoldUntil          DateTime?
  /// The "this role is now closed" email went out (sent once per application).
  closingEmailedAt     DateTime?
  /// Came in through a teammate's referral link.
  referrerId           String?
  /// In the Interview stage: which of the job's rounds they're in.
  interviewRound       String?
  /// Set when the candidate came in through a CSV import (undo deletes these).
  importId             String?
  /// How it ended when status is REJECTED: REJECTED (we said no) | WITHDRAWN | OFFER_DECLINED | NOT_JOINED. Null = REJECTED.
  outcome              String?
  /// Who gave the reason for the outcome: TEAM | CANDIDATE (null when no reason was given).
  outcomeReasonBy      String?
  /// Sourced people before they're in the pipeline: ADDED | CONTACTED | INTERESTED. Null for people who applied.
  sourcedState         String?
  /// Where the team found them (LinkedIn, Naukri, referral, event...).
  sourcedChannel       String?
  sourcedBy            String?
  contactedAt          DateTime?
  interestedAt         DateTime?
  /// Confirmed "same person" link across applications in a workspace (set by a recruiter).
  personId             String?
  /// On hold: the stage they were in, so they can resume there.
  holdFromStatus       JobBoardAppStatus?
  /// Accepted an offer: the agreed joining date. Hired with joinedAt null = awaiting joining.
  joiningDate          DateTime?
  joinedAt             DateTime?
  notes                String?
  rating               Int?
  appliedAt            DateTime                  @default(now())
  reviewedAt           DateTime?
  statusChangedAt      DateTime?

  /// The job seeker's account, when they applied signed in or later claimed it with a verified email.
  webUserId      String?
  WebUser        WebUser?                   @relation(fields: [webUserId], references: [id], onDelete: SetNull)
  Listing        JobBoardListing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  Notes          JobBoardApplicationNote[]
  Events         JobBoardApplicationEvent[]
  ResumeUploads  JobBoardResumeUpload[]
  AiScreening    JobBoardAiScreening?
  TalentInvites  JobBoardTalentInvite[]
  Referrer       JobBoardReferrer?          @relation(fields: [referrerId], references: [id], onDelete: SetNull)
  ShortlistVotes JobBoardShortlistVote[]
  Scorecards     JobBoardScorecard[]
  Interviews     JobBoardInterview[]
  Assessments    JobBoardAssessment[]
  Decisions      JobBoardDecision[]
  Offers         JobBoardOffer[]
  Import         JobBoardImport?            @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@unique([listingId, email])
  @@index([importId])
  @@index([personId])
  @@index([referrerId])
  @@index([statusTokenHash])
  @@index([listingId, status])
  @@index([webUserId])
  @@index([email])
  @@index([appliedAt])
  @@index([status])
  @@index([talentPoolUntil])
}

model JobBoardSaved {
  id        String   @id @default(cuid())
  listingId String
  userId    String
  createdAt DateTime @default(now())

  Listing JobBoardListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  WebUser WebUser         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listingId, userId])
  @@index([userId])
  @@index([listingId])
}

model JobBoardResumeUpload {
  id            String   @id @default(cuid())
  key           String   @unique
  sha256        String
  sizeBytes     Int
  mime          String
  listingId     String
  applicationId String?
  ipHash        String
  parseCount    Int      @default(0)
  createdAt     DateTime @default(now())

  Application JobBoardApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
}

model JobBoardApplicationNote {
  id            String   @id @default(cuid())
  applicationId String
  authorEmail   String
  authorName    String
  body          String
  mentions      String[] @default([])
  createdAt     DateTime @default(now())

  Application JobBoardApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model JobBoardApplicationEvent {
