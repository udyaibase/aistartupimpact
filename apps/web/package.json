{
  "name": "@udyaibase/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx --yes dotenv-cli -e ../../.env -- next dev --port 3000",
    "build": "prisma generate --schema=../../packages/database/prisma/schema.prisma && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:smoke": "vitest --run --config vitest.config.mts __tests__/smoke/",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@udyaibase/database": "*",
    "@udyaibase/types": "*",
    "@udyaibase/utils": "*",
    "@aws-sdk/client-s3": "^3.1160.0",
    "@neondatabase/serverless": "^1.0.2",
    "@sentry/nextjs": "^10.78.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.2",
    "@upstash/ratelimit": "^2.2.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "autoprefixer": "^10.6.2",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "google-auth-library": "^10.6.2",
    "jose": "^4.15.9",
    "lucide-react": "^0.577.0",
    "next": "^16.4.3",
    "next-auth": "^4.24.15",
    "postcss": "^8.5.32",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-simple-maps": "^3.0.0",
    "recharts": "^3.8.1",
    "resend": "^6.35.0",
    "sanitize-html": "^2.18.1",
    "speakeasy": "^2.0.0",
    "tailwind-merge": "^2.5.0",
    "tailwindcss": "^3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/react-simple-maps": "^3.0.6",
    "@types/speakeasy": "^2.0.10",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.28",
    "jsdom": "^27.4.0",
    "msw": "^2.15.0",
    "prisma": "^5.20.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
