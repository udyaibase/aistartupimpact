# Database
DATABASE_URL="postgresql://user:password@host:5432/database"

# JWT Secrets (generate each with: openssl rand -base64 32)
FOUNDER_JWT_SECRET="your-founder-jwt-secret-change-in-production"
USER_JWT_SECRET="your-user-jwt-secret-change-in-production"
# Own secret for hashing email verification codes (HMAC). Required in production; generate with: openssl rand -hex 32
OTP_HASH_SECRET="generate-a-random-64-char-hex-string"
EMPLOYER_JWT_SECRET="your-employer-jwt-secret-change-in-production"
ADMIN_JWT_SECRET="your-admin-jwt-secret-change-in-production"
NEXTAUTH_SECRET="your-nextauth-secret-change-in-production"

# Cookie Consent System
IP_HASH_SALT="generate-with-openssl-rand-hex-32-min-32-chars"
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Google OAuth (Required for Google Sign-in)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/founder/auth/google/callback"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Email Configuration (for verification emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@udyaibase.com"

# Resend (transactional + newsletter emails)
RESEND_API_KEY="re_your_api_key"
RESEND_FROM_EMAIL="no-reply@udyaibase.com"
RESEND_FROM_NAME="Udyaibase"
RESEND_NEWSLETTER_EMAIL="events@udyaibase.com"
RESEND_NEWSLETTER_NAME="Udyaibase Events"
RESEND_REPLY_TO="hello@udyaibase.com"

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# Sentry (error tracking)
NEXT_PUBLIC_SENTRY_DSN="https://your-dsn@sentry.io/project-id"
SENTRY_AUTH_TOKEN="sntrys_your-auth-token"

# App URLs
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"

# Production URLs (uncomment for production)
# GOOGLE_REDIRECT_URI="https://yourdomain.com/api/founder/auth/google/callback"
# NEXT_PUBLIC_WEB_URL="https://yourdomain.com"
# NEXT_PUBLIC_ADMIN_URL="https://admin.yourdomain.com"

# Cloudflare Turnstile (bot protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Meeting apps (organizer Settings -> Meeting apps). Redirect URIs to register:
#   {NEXT_PUBLIC_SITE_URL}/api/organizer/integrations/zoom/callback
#   {NEXT_PUBLIC_SITE_URL}/api/organizer/integrations/google/callback
# Tokens are encrypted with ENCRYPTION_KEY. Leave these empty to hide the buttons.
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
# Google Meet needs its own OAuth client (Calendar API on, calendar.events scope). Separate from sign-in on purpose.
GOOGLE_MEET_CLIENT_ID=""
GOOGLE_MEET_CLIENT_SECRET=""
